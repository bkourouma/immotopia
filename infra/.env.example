# ---------------------------------------------------------------------------
# Modele du fichier d'environnement d'UNE pile ImmoTopia : STAGING ou PRODUCTION.
#
# Le fichier reel vit HORS du depot, sur le serveur, un par environnement
# (chmod 600, proprietaire deployer) :
#     staging  /home/deployer/immotopia-saas.env    (app.immotopia.cloud)
#     prod     /home/deployer/immotopia-prod.env    (clients.immotopia.cloud)
#
# Ne l'ecris pas a la main : ./infra/scripts/make-env.sh <staging|prod> le genere
# avec des secrets neufs et les valeurs ci-dessous. Ce modele documente les
# variables ; les valeurs propres a chaque environnement sont indiquees
# « staging : ... / prod : ... ».
#
# Il n'est jamais versionne, jamais copie dans une image, jamais affiche.
# infra/scripts/deploy.sh <env> le passe a Compose via --env-file.
#
# NON secret et hors de ce fichier : les reglages de l'environnement (nom de la
# pile, ports, origine publique, VITE_SHOW_DEMO_ACCOUNTS...) vivent dans
# infra/environments/<env>.conf, versionne. En particulier VITE_SHOW_DEMO_ACCOUNTS
# n'est PAS lu depuis ce fichier : Compose le recoit de la conf, et il est fige
# dans le bundle du front (true en staging, false en prod).
#
# Chaque pile a SES PROPRES secrets : deploy.sh prod refuse un JWT_SECRET ou un
# POSTGRES_PASSWORD identique a celui du staging.
#
# Apres toute modification d'une variable lue par l'API :
#     ./infra/scripts/deploy.sh <env> --no-build     # recree les conteneurs
# Apres modification de PUBLIC_ORIGIN (dans la conf) : rebuild obligatoire du
# front, les valeurs VITE_* etant figees dans le bundle.
# ---------------------------------------------------------------------------


# === Base de donnees ========================================================
# Ces trois variables initialisent le conteneur Postgres au PREMIER demarrage
# seulement. Les changer ensuite ne change pas la base : il faut un ALTER USER.
POSTGRES_USER=immotopia
# openssl rand -base64 36 | tr -dc 'A-Za-z0-9' | head -c 40
# Volontairement alphanumerique : un caractere reserve devrait etre encode
# pour DATABASE_URL, source classique d'erreurs d'authentification.
POSTGRES_PASSWORD=REMPLACER
POSTGRES_DB=immotopia

# L'hote est l'alias reseau du conteneur Postgres de LA PILE, pas localhost :
# l'API tourne dans un autre conteneur du reseau <pile>-network.
#   staging : @immotopia-saas-postgres:5432
#   prod    : @immotopia-prod-postgres:5432
# deploy.sh refuse une DATABASE_URL qui ne vise pas la pile de l'environnement.
# Le mot de passe doit etre IDENTIQUE a POSTGRES_PASSWORD ci-dessus.
DATABASE_URL=postgresql://immotopia:REMPLACER@immotopia-saas-postgres:5432/immotopia?schema=public


# === Authentification =======================================================
# REQUIS. packages/api/src/config/env.ts refuse de demarrer si le secret fait
# moins de 32 caracteres ou vaut une des valeurs d'exemple connues.
# DISTINCT entre staging et prod.
#   openssl rand -base64 48
JWT_SECRET=REMPLACER
JWT_EXPIRES_IN=15m

# Cle AES-256 (32 octets en base64) qui chiffre les cles API de paiement
# enregistrees par les agences.
#   openssl rand -base64 32
# A SAUVEGARDER HORS SERVEUR : la perdre rend ces cles illisibles. Distincte par
# environnement.
PAYMENT_SECRETS_KEY=REMPLACER


# === Environnement et URL ===================================================
NODE_ENV=production
PORT=8001

# Toutes egales a l'origine publique de l'environnement (PUBLIC_ORIGIN de
# infra/environments/<env>.conf) : deploy.sh le verifie.
#   staging : https://app.immotopia.cloud
#   prod    : https://clients.immotopia.cloud
# Ces URL doivent etre valides (validation zod).
# FRONTEND_URL est l'unique origine autorisee par le CORS de l'API et sert de
# base aux liens des e-mails (reinitialisation de mot de passe, invitations).
FRONTEND_URL=https://app.immotopia.cloud
CLIENT_URL=https://app.immotopia.cloud
# BACKEND_URL est la meme origine : le nginx du conteneur web proxifie /api.
BACKEND_URL=https://app.immotopia.cloud

# Lue par deploy.sh pour verifier la coherence avec la conf de l'environnement.
# N'est PAS lue par l'API.
PUBLIC_ORIGIN=https://app.immotopia.cloud

# Documents televerses. Monte depuis le volume <pile>-uploads-data.
UPLOADS_DIR=/data/uploads

# Garde-fous : warn journalise sans bloquer, enforce bloque. Passer a enforce
# seulement apres validation (voir packages/api/env.example).
TENANT_GUARD_MODE=warn
SUBSCRIPTION_ENFORCEMENT=warn

# Assistant IA (ImmoCopilot). disabled = coupe, l'application marche sans cle.
# AI_PROVIDER, AI_MODEL... sont des valeurs PAR DEFAUT : le reglage du super-admin
# (ecran « Assistant IA », en base) est prioritaire. Les CLES restent ici, jamais en
# base : ANTHROPIC_API_KEY si le fournisseur est `anthropic`, OPENROUTER_API_KEY s'il
# est `openrouter`. Staging : `disabled`, ou une cle PROPRE au staging (jamais celle
# de la production ; deploy.sh le signale). Le faux fournisseur `fake` est refuse.
AI_PROVIDER=disabled


# === Paiement ===============================================================
# --- staging : SIMULATEUR ---
# Paiement en ligne sans argent reel.
PAYMENT_GATEWAY_SIMULATOR=1
PLATFORM_PAYSECUREHUB_MODE=SIMULATOR
#
# --- prod : REEL ---
# NE PAS definir PAYMENT_GATEWAY_SIMULATOR (deploy.sh prod refuse la valeur 1).
# Le mode LIVE exige les deux lignes suivantes ; sans elles le paiement des
# abonnements reste simule (deploy.sh prod avertit si le mode n'est pas LIVE).
# PLATFORM_PAYSECUREHUB_MODE=LIVE
# PLATFORM_PAYSECUREHUB_API_KEY=
# PLATFORM_PAYSECUREHUB_MERCHANT_ID=


# === Emetteur des factures d'abonnement =====================================
# Mentions legales imprimees sur chaque facture de la plateforme. Aucune n'est
# un secret. Prod : RCCM, numero fiscal et adresse sont a renseigner
# (deploy.sh prod avertit s'ils sont vides).
PLATFORM_ISSUER_NAME=Alliance Consultants
PLATFORM_ISSUER_EMAIL=support@immotopia.cloud
PLATFORM_ISSUER_RCCM=
PLATFORM_ISSUER_TAX_ID=
PLATFORM_ISSUER_ADDRESS=
PLATFORM_ISSUER_PHONE=


# === Integrations optionnelles ==============================================
# Toutes peuvent rester vides au premier deploiement : le code teste leur
# presence avant de s'en servir. A renseigner quand le besoin se presente.
#
# STAGING : les laisser VIDES ou les brancher sur un bac a sable. JAMAIS les
# identifiants de la production : un test enverrait de vrais messages.
# PROD : ce sont les integrations reelles, avec des identifiants dedies.
#
# PIEGE : « vide » et « absent » ne sont PAS la meme chose pour zod.
# CLIENT_URL et GOOGLE_CALLBACK_URL sont declares `z.string().url().optional()`
# dans packages/api/src/config/env.ts : `.optional()` accepte l'ABSENCE de la
# variable, pas la chaine vide, qui echoue la validation d'URL et empeche l'API
# de demarrer. Pour ces deux-la : soit une URL valide, soit la ligne COMMENTEE.
# Les variables ci-dessous ne sont pas validees par zod (elles passent par
# `.passthrough()`), la chaine vide y est sans danger.

# --- E-mail (liens de reinitialisation, invitations, newsletter) ---
# Tant que c'est vide, aucun e-mail ne part : une invitation creee ne sera pas
# recue. C'est la premiere integration a brancher apres la mise en ligne.
EMAIL_SERVICE_TYPE=
EMAIL_SERVICE_API_KEY=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# --- WhatsApp ---
WHATSAPP_PROVIDER=
WASENDER_API_BASE_URL=
WASENDER_API_KEY=
WASENDER_SESSION_NAME=
WHATSAPP_DEFAULT_COUNTRY_CODE=
WHATSAPP_GROUP_INVITE_LINK=
WHATSAPP_GROUP_BROADCAST_TO=
WHATSAPP_GROUP_PROPERTY_URL_TEMPLATE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Google OAuth ---
# Tant que ces deux variables sont vides, la connexion Google est desactivee :
# /api/auth/google repond 503 et le bouton est masque sur l'ecran de connexion.
# Les valeurs viennent de la console Google Cloud (identifiants OAuth 2.0,
# type « Application Web »), un client PAR environnement.
# Renseigner avec : ./infra/scripts/set-google-oauth.sh <staging|prod>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL est FACULTATIVE : quand elle est absente, l'API la deduit
# de BACKEND_URL, ce qui donne
#     <PUBLIC_ORIGIN>/api/auth/google/callback
# C'est cette URL, au caractere pres, qu'il faut declarer dans « URI de
# redirection autorises » cote Google. L'API la journalise au demarrage.
# Ne la renseigner que pour la forcer sur autre chose, et JAMAIS a vide :
# elle est validee comme URL par zod, une chaine vide bloque le demarrage.
