# syntax=docker/dockerfile:1
#
# Image du front : build Vite puis nginx.
#
# Le contexte de build est la RACINE DU DEPOT, comme pour packages/api/Dockerfile :
# le monorepo npm workspaces n'a qu'un seul package-lock.json, a la racine.
#   docker build -f infra/compose/Dockerfile.web .
#
# ATTENTION : Vite INLINE les valeurs VITE_* dans le bundle au moment du build.
# Changer VITE_API_ORIGIN, VITE_API_URL ou VITE_SHOW_DEMO_ACCOUNTS impose de
# reconstruire cette image ; aucune variable d'environnement au demarrage du
# conteneur n'y changera rien. Une image est donc propre a UN environnement
# (staging ou production) : docker-compose.prod.yml passe les valeurs via les
# ARG, a partir de infra/environments/<env>.conf.

FROM node:20-alpine AS build
WORKDIR /repo

# Manifestes d'abord, pour que la couche d'installation soit mise en cache
# independamment des sources. .npmrc porte legacy-peer-deps=true : sans lui,
# l'install echoue sur les pairs d'AntD et react-big-calendar.
COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/api/package.json packages/api/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/

# Les devDependencies sont NECESSAIRES ici : `npm run build -w @immotopia/web`
# commence par `tsc --noEmit`, et apps/web/tsconfig.json declare les types
# vite/client, vitest/globals et @testing-library/jest-dom.
#
# --ignore-scripts est sans danger pour le front : aucun module natif a
# compiler. rollup et esbuild passent par leurs paquets optionnels de
# plateforme, et @rollup/rollup-linux-x64-musl est bien present dans le
# lockfile (verifie), donc l'Alpine musl est servi correctement.
RUN npm ci --ignore-scripts --workspace @immotopia/web --include-workspace-root

COPY packages/tsconfig packages/tsconfig
COPY apps/web apps/web

# Meme origine que la page : le nginx embarque proxifie /api et /uploads vers
# le conteneur d'API. Voir apps/web/src/config/api.ts.
#
# VITE_API_ORIGIN doit rester ABSOLU : il ne sert pas aux appels REST (c'est
# VITE_API_URL qui les porte) mais a fabriquer les URL de fichiers dans
# `fileUrl()`. Laisse vide, il retomberait sur http://localhost:8001 et toutes
# les images/documents televerses casseraient en ligne.
#
# Aucune valeur par defaut : un build lance sans --build-arg VITE_API_ORIGIN
# echoue volontairement au garde-fou ci-dessous (apps/web/src/config/api.ts
# retombe alors sur localhost:8001), plutot que de produire une image qui vise
# la mauvaise origine, par exemple celle du staging depuis la production.
ARG VITE_API_ORIGIN
ARG VITE_API_URL=/api
# Menu deroulant de comptes de test sur l'ecran de connexion. Masque par defaut :
# seul le staging l'active (VITE_SHOW_DEMO_ACCOUNTS=true dans staging.conf).
ARG VITE_SHOW_DEMO_ACCOUNTS=false
ENV VITE_API_ORIGIN=$VITE_API_ORIGIN
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SHOW_DEMO_ACCOUNTS=$VITE_SHOW_DEMO_ACCOUNTS

RUN npm run build -w @immotopia/web

# Garde-fou : si le bundle contient encore localhost:8001, le build a ignore
# les ARG et l'application serait inutilisable en ligne. Mieux vaut echouer ici.
RUN if grep -rql "localhost:8001" apps/web/build/assets; then \
      echo "ERREUR : localhost:8001 est fige dans le bundle, VITE_API_* n'a pas ete pris en compte." >&2; \
      exit 1; \
    fi

# Garde-fou : hors staging (VITE_SHOW_DEMO_ACCOUNTS != true), le bundle ne doit
# contenir AUCUN identifiant de demonstration. Le menu est retire par
# elimination de code mort (apps/web/src/pages/Login.tsx) ; ce controle fait
# echouer le build si cette elimination cessait de jouer. Les motifs viennent
# de apps/web/src/dev/dev-accounts.ts (mots de passe historiques, mot de passe
# commun des comptes de pack PackTest@2026, domaine packs.immotopia.test) : les
# mettre a jour ici s'ils changent.
RUN if [ "$VITE_SHOW_DEMO_ACCOUNTS" != "true" ] \
      && grep -rqE 'Admin@123456|DevMick@2003|PackTest@2026|packs\.immotopia\.test' apps/web/build; then \
      echo "ERREUR : des identifiants de demonstration sont presents dans le bundle alors que VITE_SHOW_DEMO_ACCOUNTS n'est pas true." >&2; \
      exit 1; \
    fi


FROM nginx:1.27-alpine AS runtime

# Retire le vhost par defaut de l'image et installe le notre.
COPY infra/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/build /usr/share/nginx/html

EXPOSE 80

# wget est fourni par busybox dans nginx:alpine.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
