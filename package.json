{
  "name": "immotopia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/tsconfig",
    "packages/eslint-config",
    "packages/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev -w @immotopia/api\" \"npm run dev -w @immotopia/web\"",
    "dev:api": "npm run dev -w @immotopia/api",
    "dev:web": "npm run dev -w @immotopia/web",
    "build": "npm run build -w @immotopia/api && npm run build -w @immotopia/web",
    "build:api": "npm run build -w @immotopia/api",
    "build:web": "npm run build -w @immotopia/web",
    "lint": "npm run lint -w @immotopia/api && npm run lint -w @immotopia/web",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs apps/web/src packages/api/src",
    "repomix": "repomix",
    "agent-bus": "node scripts/agent-bus.cjs",
    "demo:sync": "node scripts/demo-instance.cjs sync",
    "demo:status": "node scripts/demo-instance.cjs status",
    "typecheck": "npm run typecheck -w @immotopia/api && npm run typecheck -w @immotopia/web",
    "test": "npm run test -w @immotopia/api",
    "test:web": "npm run test -w @immotopia/web",
    "a11y:contrast": "npm run a11y:contrast -w @immotopia/web",
    "prepare": "node scripts/install-git-hooks.cjs",
    "wiki:export": "node scripts/wiki-fonctionnalites.cjs export",
    "wiki:check": "node scripts/wiki-fonctionnalites.cjs check",
    "wiki:search": "node scripts/wiki-fonctionnalites.cjs search"
  },
  "lint-staged": {
    "packages/api/**/*.ts": [
      "node node_modules/prettier/bin/prettier.cjs --write",
      "node node_modules/eslint/bin/eslint.js --fix"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "node node_modules/prettier/bin/prettier.cjs --write",
      "node node_modules/eslint/bin/eslint.js --fix"
    ],
    "**/*.{json,md,yml,yaml}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ]
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "chrome-devtools-mcp": "^0.10.1",
    "concurrently": "^8.2.2",
    "dependency-cruiser": "16.10.4",
    "lefthook": "2.1.14",
    "lint-staged": "^17.5.0",
    "repomix": "1.14.0"
  }
}
