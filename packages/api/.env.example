# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/immobillier?schema=public"

# Authentication Secrets
JWT_SECRET="changeme_in_production_secret_key_12345"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Client URL (for CORS and redirects)
CLIENT_URL="http://localhost:3001"

# Communication – SMTP (notifications email, invitations, reset password)
# Requis pour envoyer des emails. Voir docs/ENV-SMTP-CONFIG.md
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# Optionnel : en test, mettre 1 pour autoriser l'envoi
# ENABLE_EMAILS=0

# Communication – WhatsApp (Twilio). Voir docs/TWILIO-WHATSAPP-SETUP.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Frontend URL (liens dans les emails)
FRONTEND_URL=http://localhost:3000
