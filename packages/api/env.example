# Database
DATABASE_URL="postgresql://user:password@localhost:5432/immotopia?schema=public"

# JWT Secrets — REQUIRED, minimum 32 characters.
# The API refuses to start if JWT_SECRET is missing, too short, or still set to
# the example value below. Generate one with: openssl rand -base64 48
JWT_SECRET=""
REFRESH_TOKEN_SECRET=""
# Access token lifetime (default 15m)
JWT_EXPIRES_IN="15m"

# Email Service Configuration
EMAIL_SERVICE_TYPE="smtp"
EMAIL_SERVICE_API_KEY="your-email-service-api-key"
EMAIL_FROM="noreply@immotopia.com"
EMAIL_SMTP_HOST="smtp.mailtrap.io"
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER="your-smtp-user"
EMAIL_SMTP_PASS="your-smtp-password"

# Application URLs (required for email links - locataires/propriétaires receive reset-password link)
# In production: set to your domain (e.g. https://app.immotopia.com)
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8001"
CLIENT_URL="http://localhost:3000"

# Where uploaded files are stored. Leave empty to use <repo>/uploads.
# Set an absolute path in production (outside the deployment directory).
UPLOADS_DIR=""

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8001/api/auth/google/callback"

# WhatsApp Provider
# WHATSAPP_PROVIDER="wasender" | "twilio"
# If empty, API auto-selects "wasender" when WASENDER_API_KEY is present, otherwise "twilio".
WHATSAPP_PROVIDER="wasender"

# WaSender settings
WASENDER_API_BASE_URL="https://wasenderapi.com/api"
WASENDER_API_KEY="your-wasender-api-key"
# Optional if your WaSender setup requires a specific session hint
WASENDER_SESSION_NAME=""
WASENDER_TIMEOUT_MS=10000
# Used when users enter local numbers without country prefix (example: 225 for CI)
WHATSAPP_DEFAULT_COUNTRY_CODE="225"
# Auto-invite CRM contacts to WhatsApp group on contact creation
WHATSAPP_GROUP_AUTO_INVITE_ON_CONTACT_CREATE="1"
# Auto-send property publication broadcast to WhatsApp group
WHATSAPP_GROUP_NOTIFY_ON_PROPERTY_PUBLISH="1"
# Public invite link sent to CRM contacts
WHATSAPP_GROUP_INVITE_LINK="https://chat.whatsapp.com/FigaM5mUQaqDHRk6YAaS0l?mode=gi_t"
# WhatsApp destination for group broadcasts (provider-specific id or destination)
WHATSAPP_GROUP_BROADCAST_TO=""
# Optional public property URL template used in group broadcast messages
# Example: https://app.immotopia.com/properties/{{propertyId}}
WHATSAPP_GROUP_PROPERTY_URL_TEMPLATE=""
# Send newsletter campaigns on WhatsApp too when recipient has consent + number
NEWSLETTER_WHATSAPP_ENABLED="1"

# Twilio settings (used only when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Environment
NODE_ENV="development"
PORT=8001

# Set ENABLE_EMAILS=1 to force email sending even when NODE_ENV=test (for manual flow testing)
# ENABLE_EMAILS=

# `npm run db:seed` deletes every user, tenant and all cascading data.
# It refuses to run unless this is set (and always refuses in production).
# ALLOW_DESTRUCTIVE_SEED=1

# Paiement en ligne des loyers (lot 7) — agrégateur PaySecureHub.
# Chiffre les clés API des agences (AES-256-GCM). Optionnelle : sans elle,
# aucune agence ne peut enregistrer de clé API (mode simulateur seulement).
# Générer avec : openssl rand -base64 32
PAYMENT_SECRETS_KEY=""
PAYSECUREHUB_BASE_URL="https://rest-airtime.paysecurehub.com/api"
PAYSECUREHUB_TIMEOUT_MS=15000
# "1" pour autoriser le simulateur PaySecureHub en production (démonstration).
# Hors production, il est toujours disponible.
# PAYMENT_GATEWAY_SIMULATOR=1

# Paiement de l'abonnement des agences (factures PLATFORM) : compte
# PaySecureHub d'ImmoTopia, distinct des comptes des agences (lot 7).
#   SIMULATOR — fausse page de paiement servie par l'API (hors production, ou
#               en production avec PAYMENT_GATEWAY_SIMULATOR=1).
#   LIVE      — exige la cle et l'identifiant marchand ci-dessous.
# Sans configuration utilisable, seul le constat manuel du super-admin reste.
PLATFORM_PAYSECUREHUB_MODE="SIMULATOR"
PLATFORM_PAYSECUREHUB_API_KEY=""
PLATFORM_PAYSECUREHUB_MERCHANT_ID=""

# Emetteur des factures d'abonnement des agences (factures PLATFORM, vague 3).
# Mentions legales imprimees sur chaque facture et FIGEES dans la facture a
# son emission (issuer_snapshot) : les modifier ne change aucune facture deja
# emise. A renseigner avant la mise en production (RCCM, compte contribuable).
PLATFORM_ISSUER_NAME="Alliance Consultants"
PLATFORM_ISSUER_ADDRESS=""
PLATFORM_ISSUER_RCCM=""
PLATFORM_ISSUER_TAX_ID=""
PLATFORM_ISSUER_EMAIL="support@immotopia.cloud"
PLATFORM_ISSUER_PHONE=""
# Jours laisses pour regler une facture de depassement mensuel (abonnement annuel).
PLATFORM_INVOICE_DUE_DAYS=7

# Liens securises en lecture seule (lib/secure-links) : duree par defaut et
# plafond, en jours. Le jeton n'est jamais stocke en clair (SHA-256 en base).
SECURE_LINK_DEFAULT_TTL_DAYS=7
SECURE_LINK_MAX_TTL_DAYS=30
# Rapport mensuel envoye aux proprietaires par tache planifiee (true/false).
PATRIMOINE_MONTHLY_REPORT_JOB_ENABLED=false
# Lot 040 (stock de chantier) : recapitulatif e-mail des alertes de stock,
# envoye toutes les 10 minutes aux responsables du stock (true/false).
# La purge nocturne des cles d'idempotence du stock (3 h UTC) tourne toujours.
STOCK_ALERT_MAIL_JOB_ENABLED=false

# Tenant guard (utils/prisma-tenant-guard-extension.ts) — second line of
# defence against cross-agency reads/writes, on top of each service's own
# `where: { tenantId }` filter.
#   off     — no check at all.
#   warn    — logs the offending model/operation/tenant and lets the query
#             through. Safe everywhere; this is the default.
#   enforce — throws (500, generic message to the client) instead of letting
#             an unscoped query or a cross-agency result through.
# Recommended sequence: run in `warn`, fix every logged call site (search the
# logs for "Tenant guard"), replay the E2E scenarios with no warning left,
# only then switch to `enforce` — first in test, then in production.
TENANT_GUARD_MODE="warn"

# Journal d'audit : retention, scellement et purge (ADR-006, phase 5).
# Les durees sont des defauts a valider. La purge est DESTRUCTIVE : elle reste
# desactivee tant que AUDIT_PURGE_ENABLED n'est pas "true". Le scellement
# quotidien (racine de Merkle + chaine) est toujours actif.
# - lignes visibles de l'agence : 24 mois ; lignes reservees a la plateforme : 60 mois.
# - minimum 7 mois : la base refuse de purger des lignes de moins de 180 jours.
AUDIT_RETENTION_TENANT_MONTHS=24
AUDIT_RETENTION_PLATFORM_MONTHS=60
AUDIT_SEAL_GRACE_DAYS=2
AUDIT_PURGE_ENABLED=false

# Abonnements par packs (src/lib/subscription, docs/architecture/PLAN-ABONNEMENTS.md).
# Ce que font les gardes de modules, la lecture seule d'un abonnement echu et
# les quotas (lots, coproprietes, chantiers) :
#   off     — droits calcules et affiches, jamais appliques.
#   warn    — (defaut) tout passe, chaque refus qui AURAIT eu lieu est journalise.
#   enforce — module absent -> 403 MODULE_NOT_INCLUDED, module retire ou
#             abonnement echu -> lecture seule, quota selon la politique de
#             l'agence (BLOCK / BILL_OVERAGE / WARN_ONLY).
# Les portails et paiements des locataires ne sont jamais bloques.
SUBSCRIPTION_ENFORCEMENT="warn"

# Base de test DEDIEE aux tests d'etancheite multi-tenant bout en bout
# (lot E, __tests__/integration/isolation.test.ts) — JAMAIS la base de
# developpement pointee par DATABASE_URL ci-dessus. `npm run test:isolation`
# applique les migrations sur cette base puis lance la suite ; si la variable
# est absente, la suite s'auto-ignore (describe.skip) et `npm test` reste vert.
# DATABASE_URL_TEST="postgresql://user:password@localhost:5432/immotopia_isolation_test?schema=public"

# ImmoCopilot — assistant IA (src/lib/ai, docs/architecture/PLAN_IMMOCOPILOT.md).
# AI_PROVIDER, AI_MODEL, AI_EFFORT et AI_REFUSAL_FALLBACK sont des VALEURS PAR
# DEFAUT : le reglage saisi par le super-admin dans l'administration de la
# plateforme (table platform_ai_settings, /api/platform/ai-settings) est
# PRIORITAIRE des qu'il existe. Les CLES API (ANTHROPIC_API_KEY,
# OPENROUTER_API_KEY) ne sont lues QUE d'ici : jamais en base, jamais renvoyees
# par l'API.
# Le faux fournisseur n'est accepte que si NODE_ENV vaut EXPLICITEMENT
# "development" ou "test" (jamais NODE_ENV absent ni "production").
# AI_PROVIDER :
#   disabled  — (defaut) assistant coupe : GET /ai/status renvoie enabled:false,
#               le bouton est masque, /chat et /actions/execute repondent 503.
#               L'application fonctionne sans aucune cle.
#   fake      — faux fournisseur deterministe pour la recette et les tests.
#               Refuse en production (le serveur ne demarre pas).
#   anthropic — API Claude ; exige ANTHROPIC_API_KEY. Aucune valeur par defaut
#               pour la cle : ne jamais la commiter.
#   openrouter — API OpenRouter (compatible OpenAI) ; exige OPENROUTER_API_KEY
#               et un AI_MODEL au format OpenRouter. Meme remarque sur la cle.
AI_PROVIDER="disabled"
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
# OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Modele utilise : "claude-opus-5-5" pour anthropic ; pour openrouter, un
# identifiant OpenRouter "fournisseur/modele" (ex. "anthropic/claude-sonnet-4.5").
AI_MODEL="claude-opus-5-5"
# Effort de raisonnement : low | medium | high (defaut low).
AI_EFFORT="low"
# Plafond de tokens de sortie par tour (1024 a 64000, defaut 16000).
AI_MAX_OUTPUT_TOKENS=16000
# Tours d'outils maximum par requete de chat (1 a 8, defaut 4).
AI_MAX_TOOL_ROUNDS=4
# Delai maximal d'un appel au fournisseur, en millisecondes (defaut 60000).
AI_REQUEST_TIMEOUT_MS=60000
# Duree de validite d'une proposition d'action a confirmer, en secondes
# (60 a 900, defaut 300). Le jeton est signe a partir de JWT_SECRET.
AI_PROPOSAL_TTL_SECONDS=300
# Duree de validite d'un plan d'ecriture generique a approuver (ImmoCopilot,
# etape 4), en secondes (300 a 3600, defaut 900) : le temps de lire les changements
# et, pour un plan sensible, de saisir le mot de confirmation.
AI_WRITE_PLAN_TTL_SECONDS=900
# Repli serveur en cas de refus du modele : on (defaut) | off.
AI_REFUSAL_FALLBACK="on"
# Plafonds de POST /ai/chat PAR AGENCE (tous collaborateurs confondus), en plus
# des limites par utilisateur (20/minute, 300/jour). Defauts : 100/minute, 3000/jour.
# ATTENTION : ces compteurs sont en memoire, PAR instance d'API. Avec N instances,
# le plafond effectif par agence est N x la valeur configuree.
AI_TENANT_MINUTE_LIMIT=100
AI_TENANT_DAILY_LIMIT=3000

# Sections exclusives d'ImmoCopilot (generation de quittances) : au plus 2 par
# processus d'API (constante MAX_CONCURRENT_EXCLUSIVE_SECTIONS, lib/ai/advisory-lock.ts),
# chacune gardant 1 connexion « gardienne » + au moins 1 connexion de travail.
# Dimensionner le pool Prisma en consequence via le parametre `connection_limit`
# de DATABASE_URL (ajouter `?connection_limit=N` a l'URL, sans y mettre de secret ici) :
# N doit couvrir ce plafond (4 connexions) PLUS le trafic normal de l'API.
# Sinon, erreurs P2024 (delai d'attente du pool) sur toute l'API.
# Recommande : connection_limit=10 ou plus quand AI_PROVIDER n'est pas "disabled".
# Le serveur AVERTIT au demarrage (sans s'arreter) si connection_limit manque,
# est trop bas, ou n'est pas un entier > 0. Un pool sature repond vite par une
# erreur (jamais d'attente infinie) : voir docs/architecture/ai-limiteurs.md.
# En production, un avertissement rappelle aussi que les plafonds de debit sont
# comptes par instance d'API (N instances = N x le plafond).

# ---------------------------------------------------------------------------
# Inventaire de chantier par WhatsApp et IA (lot 041, specs/041-inventaire-whatsapp)
# ---------------------------------------------------------------------------
# Transport des messages :
#   disabled — defaut : webhook en 404, tache planifiee arretee ;
#   log      — rien n'est envoye : chaque reponse du bot est ecrite en base et
#              se lit dans le simulateur (developpement, staging, tests). En
#              NODE_ENV=production, exige WHATSAPP_INVENTORY_SIMULATOR=1 ;
#   meta     — API WhatsApp Cloud de Meta (production) ; exige les quatre
#              variables META_WA_* marquees « requis si meta ».
WHATSAPP_INVENTORY_TRANSPORT="disabled"
# "1" autorise en NODE_ENV=production le transport log, le simulateur et le
# faux fournisseur de vision (staging seulement). Refuse par deploy.sh sur la
# production. Hors production, le simulateur suit seul le transport log.
# WHATSAPP_INVENTORY_SIMULATOR=1
#
# Application Meta (requis si meta). Secrets d'au moins 32 caracteres pour la
# cle de l'application et le jeton de verification. Le jeton d'acces est celui,
# PERMANENT, d'un utilisateur systeme (jamais le jeton temporaire de 24 h).
# Generer le jeton de verification avec : openssl rand -base64 48
# META_WA_APP_SECRET="cle-secrete-de-l-application-meta-32-caracteres-min"
# META_WA_VERIFY_TOKEN="jeton-de-verification-du-webhook-32-caracteres-min"
# META_WA_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxx"
# META_WA_PHONE_NUMBER_ID="123456789012345"
# URL et version de l'API Graph (version a verifier au deploiement).
# META_WA_GRAPH_BASE_URL="https://graph.facebook.com"
# META_WA_GRAPH_VERSION="v23.0"
# Hotes autorises pour telecharger les photos recues (garde SSRF), separes par
# des virgules, noms d'hote seuls (sans https:// ni port). A confirmer au
# premier essai reel.
# META_WA_MEDIA_HOSTS="lookaside.fbsbx.com"
# Numero officiel du bot, au format E.164, affiche a l'ecran d'inscription.
# WHATSAPP_INVENTORY_PUBLIC_NUMBER="+2250700000000"
# Quota de secours (photos analysees par agence et par mois) sans option
# souscrite, quand SUBSCRIPTION_ENFORCEMENT vaut warn ou off (0 a 100000).
WHATSAPP_INVENTORY_WARN_QUOTA=500
#
# Analyse des photos (independante du reglage ImmoCopilot du super-admin) :
#   disabled   — defaut : le bot repond qu'il ne peut pas analyser les photos ;
#   fake       — fournisseur deterministe de recette (lit la legende fake:...) ;
#                seulement en NODE_ENV=development ou test, ou avec
#                WHATSAPP_INVENTORY_SIMULATOR=1 ;
#   gemini     — API Gemini de Google ; exige GEMINI_API_KEY ;
#   openrouter — reutilise OPENROUTER_API_KEY et OPENROUTER_BASE_URL ; exige
#                un modele "fournisseur/modele" (ex. google/gemini-2.5-flash).
STOCK_VISION_PROVIDER="disabled"
# Modele de vision (nom exact a verifier).
STOCK_VISION_MODEL="gemini-2.5-flash"
# GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Delai maximal d'une analyse, en millisecondes (2000 a 60000, defaut 20000).
STOCK_VISION_TIMEOUT_MS=20000
