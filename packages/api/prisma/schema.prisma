/// Parametres financiers d'une agence : fiscalite, honoraires de gestion,
/// comptes comptables de la gestion locative.
///
/// Un par agence au plus. Tant qu'il n'existe pas, l'API renvoie les valeurs
/// par defaut de `lib/settings/finance-settings.ts` sans rien ecrire.
///
/// `managementFeeRate` nul veut dire « non parametre », pas « zero » : un
/// releve calcule sans taux le signale au lieu de laisser croire que l'agence
/// travaille gratuitement.
model AgencyFinanceSettings {
  id                         String             @id @default(uuid()) @db.Uuid
  tenantId                   String             @unique @map("tenant_id")
  vatRegistered              Boolean            @default(false) @map("vat_registered")
  /// En pourcentage : 18 pour 18 %.
  vatRate                    Decimal            @default(18) @map("vat_rate") @db.Decimal(5, 2)
  /// Numero de compte contribuable (NCC).
  taxpayerNumber             String?            @map("taxpayer_number")
  /// En pourcentage du montant de l'assiette : 10 pour 10 %.
  managementFeeRate          Decimal?           @map("management_fee_rate") @db.Decimal(5, 2)
  managementFeeBase          ManagementFeeBase  @default(RENT_ONLY) @map("management_fee_base")
  managementFeeMode          ManagementFeeMode  @default(PERCENT) @map("management_fee_mode")
  /// Forfait par echeance mensuelle, en mode FIXED.
  managementFeeFixedAmount   Decimal?           @map("management_fee_fixed_amount") @db.Decimal(14, 2)
  /// Comptes de la gestion locative. Lus par les ecritures a partir du lot 3
  /// (compte proprietaire) ; poses ici pour que le comptable les fixe avant.
  ownerFundsAccountNumber    String?            @map("owner_funds_account_number")
  managementFeeAccountNumber String?            @map("management_fee_account_number")
  vatCollectedAccountNumber  String?            @map("vat_collected_account_number")
  /// Lot 10 : ecarts de caisse (6588 / 7588 par defaut).
  cashShortageAccountNumber  String?            @map("cash_shortage_account_number")
  cashSurplusAccountNumber   String?            @map("cash_surplus_account_number")
  /// Lot 10 : a qui reviennent les penalites de retard encaissees.
  penaltyBeneficiary         PenaltyBeneficiary @default(OWNER) @map("penalty_beneficiary")
  penaltyIncomeAccountNumber String?            @map("penalty_income_account_number")
  /// Lot 10 : retenue a la source sur loyers. Desactivee par defaut, en
  /// attente de la confirmation du cabinet.
  withholdingEnabled         Boolean            @default(false) @map("withholding_enabled")
  /// Premier jour d'encaissement soumis a la retenue : l'activer ne retient
  /// jamais sur les loyers deja encaisses.
  withholdingStartsOn        DateTime?          @map("withholding_starts_on") @db.Date
  withholdingRateIndividual  Decimal            @default(12) @map("withholding_rate_individual") @db.Decimal(5, 2)
  withholdingRateCompany     Decimal            @default(15) @map("withholding_rate_company") @db.Decimal(5, 2)
  withholdingAccountNumber   String?            @map("withholding_account_number")
  updatedByUserId            String?            @map("updated_by_user_id")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("agency_finance_settings")
}

/// Reglage du portail proprietaire (lot P5) : masquage de la vue patrimoine
/// et de ses rubriques. Tant que l'agence n'a rien enregistre, la lecture
/// renvoie les valeurs par defaut (tout actif) SANS ecrire -- meme patron
/// que `AgencyFinanceSettings` (`lib/settings/finance-settings.ts`).
