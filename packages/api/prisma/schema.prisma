/// Releve de gerance d'un proprietaire pour un mois.
///
/// Un releve est un INSTANTANE : ses totaux sont stockes parce qu'un releve
/// envoye ne doit pas changer apres coup si un paiement est saisi en retard.
///
/// - `totalRevenue`  : loyers reellement ENCAISSES dans le mois (date du
///   reglement), arrieres compris. Pas le loyer du contrat.
/// - `totalRentDue`  : ce qui etait appele sur les echeances du mois.
/// - `totalArrears`  : reste du a la fin du mois, toutes echeances echues.
/// - `netAmount`     : encaisse - honoraires - TVA - depenses.
///
/// `computationVersion` 1 designe les releves calcules avant le 22 septembre
/// 2026, qui prenaient le loyer du contrat de chaque bail actif pour un loyer
/// encaisse. Ils restent lisibles et peuvent etre recalcules.
model OwnerStatement {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @map("tenant_id")
  ownerContactId         String             @map("owner_contact_id")
  period                 String
  totalRevenue           Decimal            @map("total_revenue") @db.Decimal(14, 2)
  totalExpenses          Decimal            @map("total_expenses") @db.Decimal(14, 2)
  netAmount              Decimal            @map("net_amount") @db.Decimal(14, 2)
  totalRentDue           Decimal            @default(0) @map("total_rent_due") @db.Decimal(14, 2)
  totalArrears           Decimal            @default(0) @map("total_arrears") @db.Decimal(14, 2)
  totalManagementFees    Decimal            @default(0) @map("total_management_fees") @db.Decimal(14, 2)
  totalManagementFeesVat Decimal            @default(0) @map("total_management_fees_vat") @db.Decimal(14, 2)
  /// Parametres appliques au calcul, figes avec le releve.
  managementFeeRate      Decimal?           @map("management_fee_rate") @db.Decimal(5, 2)
  managementFeeBase      ManagementFeeBase? @map("management_fee_base")
  vatRate                Decimal?           @map("vat_rate") @db.Decimal(5, 2)
  /// Biens retenus a la generation, pour pouvoir recalculer a l'identique.
  propertyIds            String[]           @default([]) @map("property_ids")
  computationVersion     Int                @default(1) @map("computation_version")
  currency               String             @default("XOF")
  status                 StatementStatus    @default(DRAFT)
  sentAt                 DateTime?          @map("sent_at")
  paidAt                 DateTime?          @map("paid_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  CrmContact           @relation(fields: [ownerContactId], references: [id], onDelete: Cascade)
  items  OwnerStatementItem[]

  @@unique([tenantId, ownerContactId, period])
  @@index([tenantId])
  @@index([ownerContactId])
  @@index([tenantId, period])
  @@map("owner_statements")
}

model OwnerStatementItem {
  id          String            @id @default(uuid()) @db.Uuid
  statementId String            @map("statement_id") @db.Uuid
  propertyId  String            @map("property_id")
  label       String
  type        StatementItemType
  amount      Decimal           @db.Decimal(14, 2)
  createdAt   DateTime          @default(now()) @map("created_at")

  statement OwnerStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  property  Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([propertyId])
  @@map("owner_statement_items")
}

/// Programme de travaux sur un bien existant.
