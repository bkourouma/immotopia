  CANCELLED
}

enum ResolutionResult {
  APPROVED
  REJECTED
  DEFERRED
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum SyndicateDocType {
  REGULATION
  GENERAL_MEETING_MINUTES
  DIAGNOSTIC
  INSURANCE
  BUDGET
  OTHER
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BatchType {
  REGULAR
  EXCEPTIONAL
}

enum BatchStatus {
  DRAFT
  SENT
  CLOSED
}

enum PaymentType {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CHECK
  CARD
}

enum ReminderChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum ReminderStatus {
  SENT
  DELIVERED
  FAILED
}

enum ScheduleStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum InstalmentStatus {
  PENDING
  PAID
  LATE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalType {
  GENERAL
  BANK
  CASH
  CHARGES
}

enum SourceType {
  CHARGE_PAYMENT
  MANUAL
  PENALTY
  FUND
  // Lot 2 : les pieces operationnelles. Ajouter une valeur a un enum Postgres
  // est non bloquant et sans effet sur les lignes existantes.
  SUPPLIER_INVOICE
  SUPPLIER_PAYMENT
  CASH_VOUCHER
  VOID
  // Lot 4 : les pieces des baux de terrain. Sans elles, chaque ecriture de
  // bail portait `MANUAL` et le grand livre perdait une distinction qu'il a
  // pour toutes les autres pieces du module.
  LAND_LEASE_PAYMENT
  LAND_LEASE_ACCRUAL
  // Lot 4, sous-lot 3 : les salaires.
  SALARY_NOTE
  SALARY_PAYMENT
  // Lot 4, sous-lot 4 : les tacherons.
  PROGRESS_STATEMENT
  CONTRACTOR_PAYMENT
  // Lot 4, sous-lot 5 : les retenues de garantie. DEUX valeurs et non une :
  // la pose et la liberation sont deux ecritures portant le meme
  // identifiant de retenue, et `JournalEntry` refuse deux ecritures pour le
  // meme couple (nature, piece). Une seule valeur rendrait la liberation
  // impossible a enregistrer.
  RETENTION_HELD
  RETENTION_RELEASED
  // Lot 5 : le stock. La reception entre en stock, la sortie en sort et
  // devient une charge, l'ajustement constate un ecart d'inventaire. Le
  // transfert n'ecrit rien : deplacer du stock ne cree ni ne detruit de
  // valeur, et le compte 311 ne bouge pas.
  STOCK_RECEIPT
  STOCK_ISSUE
  STOCK_ADJUSTMENT
  // Gestion locative, lot 3 : le compte des proprietaires mandants.
  OWNER_RENT_COLLECTED
  OWNER_MANAGEMENT_FEE
  OWNER_EXPENSE
  OWNER_PAYOUT
  // Lot 6 : l'ecart constate a la cloture d'une session de caisse.
  CASH_SESSION_DIFFERENCE
  // Lot 10, conformite SYSCOHADA.
  OWNER_UNALLOCATED
  OWNER_AUX_REALLOC
  OWNER_WITHHOLDING
  OWNER_DEPOSIT
  TREASURY_TRANSFER
  TAX_REMITTANCE
  // Lot 9 : ventes immobilieres. Le versement d'une commission de transaction.
  SALE_COMMISSION_PAYMENT
  // Syndic S6 : factures et reglements des prestataires d'une copropriete.
  PROVIDER_INVOICE
  PROVIDER_PAYMENT
}

/// Portee d'un plan de comptes, d'un journal ou d'une ecriture.
///
/// SYNDICATE : la comptabilite d'une copropriete, telle qu'elle existe depuis
/// la spec 014. OPERATIONS : la comptabilite operationnelle de l'agence,
/// introduite au lot 2. Le moteur est le meme ; seule la portee change.
enum AccountingScope {
  SYNDICATE
  OPERATIONS
}

enum BudgetStatus {
  DRAFT
  APPROVED
  REVISED
  CLOSED
}

enum DistributionKey {
  GENERAL_SHARES
  SPECIAL_SHARES
  EQUAL
  MANUAL
}

enum TransactionType {
  CHARGE_CALL
  PAYMENT
  PENALTY
  WAIVER
  ADJUSTMENT
  FUND_TRANSFER
}

enum IncidentType {
  BREAKDOWN
  LEAK
  VANDALISM
  SAFETY
  OTHER
}

enum IncidentUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ImputationType {
  SYNDICATE_BUDGET
  INSURANCE
  LOT_OWNER
  THIRD_PARTY
}

// =============================================================
// SYNDIC MODULE - MODELS
// =============================================================

model Syndicate {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id")
  propertyId         String?         @unique @map("property_id")
  name               String
  registrationNo     String?         @map("registration_no")
  fiscalYear         Int             @default(1) @map("fiscal_year")
  syndicManagerId    String?         @map("syndic_manager_id")
  address            String
  cadastralReference String?         @map("cadastral_reference")
  totalLots          Int             @default(0) @map("total_lots")
  totalBuildings     Int             @default(1) @map("total_buildings")
  status             SyndicateStatus @default(ACTIVE)
  regulationDocUrl   String?         @map("regulation_doc_url")
  /// Lot S1 : agence mandante dont l'identite figure sur les documents.
  mandatingAgencyId  String?         @map("mandating_agency_id") @db.Uuid
  /// Lot S1 : cle de stockage PRIVEE du logo de la copropriete.
  logoPath           String?         @map("logo_path")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Defense en profondeur (audit S1) : cle composite (tenant_id,
  // mandating_agency_id) -> syndic_mandating_agencies(tenant_id, id), pour
  // qu'une copropriete ne puisse jamais etre rattachee au mandant d'une
  // autre agence, meme si un bug applicatif oubliait de le verifier.
  mandatingAgency    SyndicMandatingAgency?     @relation(fields: [tenantId, mandatingAgencyId], references: [tenantId, id], onDelete: Restrict)
  property           Property?                  @relation("SyndicateProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  syndicManager      CrmContact?                @relation("SyndicManager", fields: [syndicManagerId], references: [id], onDelete: SetNull)
  lots               SyndicateLot[]
  generalMeetings    GeneralMeeting[]
  serviceContracts   MaintenanceContract[]
  commonAssets       CommonAreaAsset[]
  documents          SyndicateDocument[]
  funds              SyndicateFund[]
  chargeCalls        ChargeCall[]
  chargeCallBatches  ChargeCallBatch[]
  paymentMethods     SyndicPaymentMethod[]
  reminderConfigs    ReminderConfig[]
  budgets            SyndicateBudget[]
  chartOfAccounts    ChartOfAccount[]
  accountingJournals AccountingJournal[]
  ownerAccounts      OwnerAccount[]
  incidents          SyndicateIncident[]
  maintenanceLinks   SyndicateMaintenanceLink[]
  contractLinks      SyndicateContractLink[]
  chargeReceipts     SyndicChargeReceipt[]
  /// Lot S4 : programmations d'appels de charges automatiques.
  chargeSchedules    SyndicChargeSchedule[]
  providerInvoices   SyndicProviderInvoice[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([mandatingAgencyId])
  @@map("syndicates")
}

/// Lot S1 (besoin 7) : agence cliente du cabinet de syndic pour le compte de
/// laquelle une copropriete est geree. Elle ne se connecte jamais ; son
/// identite (logo, coordonnees, signature, cachet) figure sur les documents
/// emis pour ses coproprietes. Les images sont des cles de stockage PRIVEES
/// (`branding/<tenantId>/mandants/<id>/...`), jamais renvoyees au client.
model SyndicMandatingAgency {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id")
  name          String
  legalName     String?  @map("legal_name")
  address       String?
  phone         String?
  email         String?
  rccm          String?
  taxId         String?  @map("tax_id")
  logoPath      String?  @map("logo_path")
  signaturePath String?  @map("signature_path")
  stampPath     String?  @map("stamp_path")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cible de la cle composite de `Syndicate.mandatingAgency` (audit S1).
  syndicates Syndicate[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("syndic_mandating_agencies")
}

model SyndicateLot {
  id             String    @id @default(uuid()) @db.Uuid
  syndicateId    String    @map("syndicate_id") @db.Uuid
  propertyId     String?   @unique @map("property_id")
  coownerId      String?   @map("coowner_id")
  ownerContactId String?   @map("owner_contact_id")
  lotNumber      String    @map("lot_number")
  lotType        LotType   @map("lot_type")
  generalShares  Int       @map("general_shares")
  specialShares  Int?      @map("special_shares")
  ownerSince     DateTime? @map("owner_since")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  syndicate            Syndicate                  @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  property             Property?                  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  coowner              CrmContact?                @relation("LotCoowner", fields: [coownerId], references: [id], onDelete: SetNull)
  owner                CrmContact?                @relation("SyndicateLotOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  votes                GMVote[]
  charges              ChargeCall[]
  chargePayments       ChargePayment[]
  ownerProfiles        LotOwnerProfile[]
  tenantProfiles       LotTenantProfile[]
  tenantAssignments    LotTenantAssignment[]
  paymentReminders     PaymentReminder[]
  latePaymentPenalties LatePaymentPenalty[]
  paymentSchedules     PaymentSchedule[]
  ownerAccount         OwnerAccount?
  journalLines         JournalEntryLine[]
  budgetAllocations    BudgetAllocation[]
  incidents            SyndicateIncident[]
  incidentImputations  IncidentCostImputation[]
  maintenanceLinks     SyndicateMaintenanceLink[]
  chargeReceipts       SyndicChargeReceipt[]

  @@index([syndicateId])
  @@index([syndicateId, lotNumber])
  // Unicite (syndicate_id, lower(btrim(lot_number))) : index sur expression pose en SQL brut,
  // migration 20261005090000_syndic_lot_number_unique (non exprimable en Prisma).
  @@index([ownerContactId])
  @@map("syndicate_lots")
}

enum CostImputationType {
  SYNDICATE
  LOT_OWNER
  LOT_TENANT
  MIXED
}

model LotTenantAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  lotId     String    @map("lot_id") @db.Uuid
  tenantId  String    @map("tenant_id")
  leaseId   String?   @map("lease_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(true) @map("is_active")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")

  lot     SyndicateLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  contact CrmContact   @relation("LotTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([tenantId])
  @@index([lotId, isActive])
  @@map("lot_tenant_assignments")
}

model SyndicateMaintenanceLink {
  id                   String             @id @default(uuid()) @db.Uuid
  syndicateId          String             @map("syndicate_id") @db.Uuid
  maintenanceRequestId String             @unique @map("maintenance_request_id") @db.Uuid
  lotId                String?            @map("lot_id") @db.Uuid
  isCommonArea         Boolean            @default(false) @map("is_common_area")
  costImputation       CostImputationType @default(SYNDICATE) @map("cost_imputation")
  imputationDetail     String?            @map("imputation_detail")
  createdAt            DateTime           @default(now()) @map("created_at")

  syndicate Syndicate         @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  request   MaintenanceTicket @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  lot       SyndicateLot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([syndicateId])
  @@index([lotId])
  @@map("syndicate_maintenance_links")
}

model SyndicateContractLink {
  id                    String   @id @default(uuid()) @db.Uuid
  syndicateId           String   @map("syndicate_id") @db.Uuid
  maintenanceContractId String   @map("maintenance_contract_id") @db.Uuid
  scope                 String?
  budgetLineItemId      String?  @map("budget_line_item_id")
  createdAt             DateTime @default(now()) @map("created_at")

  syndicate Syndicate           @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  contract  MaintenanceContract @relation(fields: [maintenanceContractId], references: [id], onDelete: Cascade)

  @@index([syndicateId])
  @@index([maintenanceContractId])
  @@map("syndicate_contract_links")
}

model ChargeCall {
  id           String           @id @default(uuid()) @db.Uuid
  syndicateId  String           @map("syndicate_id") @db.Uuid
  lotId        String           @map("lot_id") @db.Uuid
  batchId      String?          @map("batch_id") @db.Uuid
  /// Libelle libre de la periode (ex. « 2026-01-01 au 2026-03-31 », « 2026-01 »).
  period       String
  /// Lot S2 : bornes structurees de la periode (dates sans heure), deduites du
  /// libelle quand elles ne sont pas fournies. Nulles si le libelle est illisible.
  periodStart  DateTime?        @map("period_start") @db.Date
  periodEnd    DateTime?        @map("period_end") @db.Date
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("XOF")
  dueDate      DateTime         @map("due_date")
  status       ChargeCallStatus @default(PENDING)
  /// Fonds qui recoit l'integralite de ce qui est paye sur cet appel (appel de
  /// fonds travaux). Nul : les fonds sont credites selon les postes du budget
  /// (`BudgetLineItem.fundId`), voir lib/syndics/fund-credits.ts.
  fundId       String?          @map("fund_id") @db.Uuid
  /// Lot S4 (anomalie recette) : date du dernier avis (e-mail ou WhatsApp)
  /// effectivement envoye pour cet appel. Nul tant qu'aucun avis n'est parti ;
  /// pose par `notifyChargeCall` (lib/syndics/notifications.ts) et lu par le
  /// renvoi des avis non envoyes (idempotence par appel, pas seulement par
  /// periode).
  noticeSentAt DateTime?        @map("notice_sent_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  syndicate      Syndicate                 @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  lot            SyndicateLot              @relation(fields: [lotId], references: [id], onDelete: Cascade)
  batch          ChargeCallBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  fund           SyndicateFund?            @relation(fields: [fundId], references: [id], onDelete: SetNull)
  /// Paiements dont c'est l'appel « principal » (compatibilite). Le montant
  /// regle d'un appel se lit TOUJOURS dans `allocations`, jamais ici.
  directPayments ChargePayment[]
  /// Lot S2 : affectations de paiements (et d'avances) a cet appel.
  allocations    ChargePaymentAllocation[]
  reminders      PaymentReminder[]
  penalties      LatePaymentPenalty[]
  schedules      PaymentSchedule[]
  /// Lot S3 : quittance emise quand l'appel est entierement solde.
  receipts       SyndicChargeReceipt[]

  @@index([syndicateId])
  @@index([lotId])
  @@index([syndicateId, period])
  @@index([batchId])
  @@index([status])
  @@index([dueDate])
  @@index([fundId])
  @@map("charge_calls")
}

/// Paiement recu d'un coproprietaire pour un lot (lot S2). Il est reparti
/// sur un ou plusieurs appels par `ChargePaymentAllocation` ; la part non
/// encore imputee (`unallocatedAmount`) constitue l'avance du lot.
model ChargePayment {
  id                String   @id @default(uuid()) @db.Uuid
  lotId             String   @map("lot_id") @db.Uuid
  /// Premier appel solde par ce paiement, conserve pour compatibilite. Nul pour
  /// une avance pure. Ne sert jamais a calculer le regle d'un appel.
  chargeCallId      String?  @map("charge_call_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  /// Part du paiement non encore affectee a un appel (avance restante).
  unallocatedAmount Decimal  @default(0) @map("unallocated_amount") @db.Decimal(12, 2)
  paidAt            DateTime @map("paid_at")
  method            String?
  reference         String?
  /// Utilisateur qui a saisi le paiement (sans cle etrangere : trace d'audit).
  createdById       String?  @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  lot         SyndicateLot              @relation(fields: [lotId], references: [id], onDelete: Cascade)
  chargeCall  ChargeCall?               @relation(fields: [chargeCallId], references: [id], onDelete: SetNull)
  allocations ChargePaymentAllocation[]
  /// Lot S3 : recu de paiement emis pour ce paiement.
  receipts    SyndicChargeReceipt[]

  @@index([chargeCallId])
  @@index([lotId, paidAt])
  @@map("charge_payments")
}

enum ChargeAllocationSource {
  /// Affectation faite au moment du paiement.
  PAYMENT
  /// Imputation ulterieure d'une avance (aucun mouvement d'argent).
  ADVANCE
}

/// Lot S2 : part d'un paiement affectee a un appel de charges.
model ChargePaymentAllocation {
  id           String                 @id @default(uuid()) @db.Uuid
  paymentId    String                 @map("payment_id") @db.Uuid
  chargeCallId String                 @map("charge_call_id") @db.Uuid
  amount       Decimal                @db.Decimal(12, 2)
  source       ChargeAllocationSource @default(PAYMENT)
  createdAt    DateTime               @default(now()) @map("created_at")

  payment    ChargePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeCall ChargeCall    @relation(fields: [chargeCallId], references: [id], onDelete: Cascade)

  @@unique([paymentId, chargeCallId])
  @@index([chargeCallId])
  @@map("charge_payment_allocations")
}

/// Lot S3 : nature d'un document de reglement de charges.
enum SyndicChargeReceiptKind {
  /// Recu de paiement : paiement qui laisse un reste du, ou avance.
  RECEIPT
  /// Quittance : un appel de charges entierement solde.
  QUITTANCE
}

/// Lot S3 (besoin 1) : recu de paiement ou quittance de charges d'un lot.
/// Un document emis est un ORIGINAL : `snapshot` fige TOUTES les donnees
/// affichees (emetteur, copropriete, lot, coproprietaire, affectations...) ;
/// le PDF stocke (`filePath`, identifiant de stockage prive, jamais renvoye
/// au client) est reconstruit a l'identique depuis ce snapshot s'il manque.
/// Une seule quittance par appel : index unique PARTIEL
/// `syndic_charge_receipts_quittance_call_key` (migration 20260929120000,
/// non exprimable ici).
model SyndicChargeReceipt {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id")
  syndicateId     String                  @map("syndicate_id") @db.Uuid
  lotId           String                  @map("lot_id") @db.Uuid
  contactId       String?                 @map("contact_id")
  kind            SyndicChargeReceiptKind
  /// Q-AAAA-NNNNNN ou R-AAAA-NNNNNN, continu par emetteur, type et annee.
  number          String
  /// Emetteur : identifiant du mandant, ou 'AGENCY'.
  issuerKey       String                  @map("issuer_key")
  chargePaymentId String?                 @map("charge_payment_id") @db.Uuid
  chargeCallId    String?                 @map("charge_call_id") @db.Uuid
  periodStart     DateTime?               @map("period_start") @db.Date
  periodEnd       DateTime?               @map("period_end") @db.Date
  periodLabel     String?                 @map("period_label")
  amount          Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("XOF")
  snapshot        Json
  filePath        String?                 @map("file_path")
  issuedAt        DateTime                @default(now()) @map("issued_at")
  emailedAt       DateTime?               @map("emailed_at")
  /// Code d'echec du dernier envoi : SMTP_REJECTED, TIMEOUT ou ERROR.
  emailErrorCode  String?                 @map("email_error_code")
  /// Message generique en francais (l'erreur brute ne va qu'aux journaux).
  emailError      String?                 @map("email_error")
  createdById     String?                 @map("created_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syndicate     Syndicate      @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  lot           SyndicateLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  contact       CrmContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  chargePayment ChargePayment? @relation(fields: [chargePaymentId], references: [id], onDelete: SetNull)
  chargeCall    ChargeCall?    @relation(fields: [chargeCallId], references: [id], onDelete: SetNull)

  @@unique([tenantId, issuerKey, number])
  @@index([tenantId, syndicateId, issuedAt])
  @@index([lotId, issuedAt])
  @@index([chargeCallId])
  @@index([chargePaymentId])
  @@index([contactId])
  @@map("syndic_charge_receipts")
}

/// Lot S3 : compteur des numeros de recus et quittances, par emetteur, type
/// et annee. Incremente par `INSERT ... ON CONFLICT DO UPDATE ... RETURNING`
/// dans la transaction d'emission : un rollback rend son numero.
model SyndicReceiptSequence {
  tenantId  String                  @map("tenant_id")
  issuerKey String                  @map("issuer_key")
  kind      SyndicChargeReceiptKind
  year      Int
  lastValue Int                     @default(0) @map("last_value")
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, issuerKey, kind, year])
  @@map("syndic_receipt_sequences")
}

