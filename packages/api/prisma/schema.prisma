  patrimonyShowYield     Boolean  @default(true) @map("patrimony_show_yield")
  patrimonyShowLoans     Boolean  @default(true) @map("patrimony_show_loans")
  patrimonyShowWorks     Boolean  @default(true) @map("patrimony_show_works")
  patrimonyShowDocuments Boolean  @default(true) @map("patrimony_show_documents")
  updatedByUserId        String?  @map("updated_by_user_id")
