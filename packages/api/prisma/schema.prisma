  @@map("owner_portal_settings")
}

/// Reglage du plan de tresorerie previsionnel (spec 030) : date d'exigibilite
/// annuelle de la taxe fonciere de l'agence. AUCUNE valeur par defaut : nul =
/// « non renseigne », et la taxe n'entre alors pas dans le plan. Une contrainte
