/// Honoraires de gestion d'un encaissement : un par affectation de reglement.
///
/// FIGES a leur creation : taux, TVA, gestionnaire et part de l'agent sont
/// ceux en vigueur ce jour-la. Changer un taux ne reecrit pas des honoraires
/// deja comptes, ni la commission due a un agent.
///
/// Crees a la demande (`lib/rental-fees/materialize.ts`) pour toute
/// affectation qui n'en a pas encore, ce qui couvre toutes les voies
/// d'affectation (saisie, campagne de facturation, declaration validee) sans
/// en modifier aucune. Disparaissent avec leur affectation : un reglement
/// annule ne laisse pas d'honoraires derriere lui.
model ManagementFee {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id")
  allocationId      String              @unique @map("allocation_id") @db.Uuid
  paymentId         String              @map("payment_id") @db.Uuid
  leaseId           String              @map("lease_id") @db.Uuid
  propertyId        String              @map("property_id")
  ownerClientId     String?             @map("owner_client_id")
  collectedAt       DateTime            @map("collected_at")
  collectedAmount   Decimal             @map("collected_amount") @db.Decimal(14, 2)
  baseAmount        Decimal             @map("base_amount") @db.Decimal(14, 2)
  source            ManagementFeeSource
  mode              ManagementFeeMode
  rate              Decimal?            @db.Decimal(5, 2)
  fixedAmount       Decimal?            @map("fixed_amount") @db.Decimal(14, 2)
  feeBase           ManagementFeeBase?  @map("fee_base")
  feeAmount         Decimal             @map("fee_amount") @db.Decimal(14, 2)
  vatRate           Decimal?            @map("vat_rate") @db.Decimal(5, 2)
  vatAmount         Decimal             @default(0) @map("vat_amount") @db.Decimal(14, 2)
  agentUserId       String?             @map("agent_user_id")
  agentSharePercent Decimal?            @map("agent_share_percent") @db.Decimal(5, 2)
  agentShareAmount  Decimal             @default(0) @map("agent_share_amount") @db.Decimal(14, 2)
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocation RentalPaymentAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([tenantId, collectedAt])
  @@index([tenantId, propertyId, collectedAt])
  @@index([agentUserId])
  @@map("management_fees")
}

