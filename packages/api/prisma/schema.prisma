  subscribers NewsletterSubscriber[]
  campaigns   NewsletterCampaign[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("newsletter_lists")
}

model NewsletterSubscriber {
  id                         String                     @id @default(uuid())
  tenantId                   String                     @map("tenant_id")
  listId                     String                     @map("list_id")
  email                      String
  name                       String?
  status                     NewsletterSubscriberStatus @default(PENDING_CONFIRMATION)
  confirmationToken          String?                    @unique @map("confirmation_token")
  confirmationTokenExpiresAt DateTime?                  @map("confirmation_token_expires_at")
  subscribedAt               DateTime                   @default(now()) @map("subscribed_at")
  confirmedAt                DateTime?                  @map("confirmed_at")
  unsubscribedAt             DateTime?                  @map("unsubscribed_at")
  sourceEntityType           String?                    @map("source_entity_type")
  sourceEntityId             String?                    @map("source_entity_id")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")

  tenant             Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list               NewsletterList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  campaignRecipients NewsletterCampaignRecipient[]

  @@unique([listId, email])
  @@index([tenantId])
  @@index([listId])
  @@index([listId, status])
  @@index([confirmationToken])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id           String                   @id @default(uuid())
  tenantId     String                   @map("tenant_id")
  listId       String                   @map("list_id")
  templateId   String?                  @map("template_id")
  subject      String
  bodyHtml     String                   @map("body_html") @db.Text
  renderedHtml String?                  @map("rendered_html") @db.Text
  status       NewsletterCampaignStatus @default(DRAFT)
  scheduledAt  DateTime?                @map("scheduled_at")
  sentAt       DateTime?                @map("sent_at")
  createdById  String?                  @map("created_by_id")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  tenant     Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list       NewsletterList                @relation(fields: [listId], references: [id], onDelete: Cascade)
  template   NewsletterTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User?                         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients NewsletterCampaignRecipient[]

  @@index([tenantId])
  @@index([listId])
  @@index([status])
  @@index([scheduledAt])
  @@index([sentAt])
  @@map("newsletter_campaigns")
}

model NewsletterCampaignRecipient {
  id               String                            @id @default(uuid())
  campaignId       String                            @map("campaign_id")
  tenantId         String                            @map("tenant_id")
  subscriberId     String?                           @map("subscriber_id")
  email            String
  status           NewsletterCampaignRecipientStatus
  sentAt           DateTime?                         @map("sent_at")
  openedAt         DateTime?                         @map("opened_at")
  failureReason    String?                           @map("failure_reason") @db.Text
  unsubscribeToken String?                           @map("unsubscribe_token")
  openToken        String?                           @map("open_token")

  campaign   NewsletterCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([tenantId])
  @@map("newsletter_campaign_recipients")
}

model NewsletterTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  html      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns NewsletterCampaign[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("newsletter_templates")
}

