/// Accès aux menus par rôle.
///
/// Le catalogue des menus vit dans le modèle de navigation du front
/// (`apps/web/src/navigation/menu-catalog.ts`) : c'est lui qui décrit l'arbre
/// réellement affiché. Cette table ne stocke donc pas le catalogue, seulement
/// la décision d'un administrateur pour un couple (rôle, menu).
///
/// `roleKey` n'est volontairement PAS une clé étrangère vers `roles` : deux
/// des personas de l'interface — le propriétaire et le locataire — sont
/// déduits de `tenant_clients.client_type` et n'ont aucune ligne dans `roles`.
/// Les clés pseudo-rôles `PORTAL_OWNER` et `PORTAL_RENTER` les représentent.
model RoleMenuAccess {
  id        String   @id @default(uuid())
  roleKey   String   @map("role_key")
  menuKey   String   @map("menu_key")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([roleKey, menuKey])
  @@index([roleKey])
  @@map("role_menu_access")
}

// =============================================================
// FINANCE OPERATIONNELLE — Lot 1, volet clients
//
// Specification : specs/016-finance-operationnelle/
// Decisions     : docs/finance/PLAN-mise-en-oeuvre.md §12
//
// Trois tables neuves, aucune table existante modifiee hors relations
// inverses. Le compte de tiers est volontairement SEPARE de `OwnerAccount`
// (decision D1) : `OwnerAccount.lotId` est obligatoire et unique par lot de
// copropriete, et son contact est un `CrmContact` la ou le locataire est un
// `TenantClient`. Generaliser cette table en place casserait la copropriete.
// Ce qui est partage, c'est le CODE de calcul du solde, extrait dans
// `src/lib/finance/ledger.ts`, pas le stockage.
//
// Aucune ecriture en partie double a ce lot (decision D2) : la balance et le
// releve se lisent sur les seuls mouvements de tiers. Les journaux arrivent
// au lot 2 avec les fournisseurs.
//
// Montants en Decimal(14,2) et devise stockee "XOF" (decision D9) ;
// l'affichage dit « FCFA », via le composant MoneyValue.
// =============================================================

/// Nature du tiers. Seul TENANT est peuple par le lot 1 ; les cinq autres
/// arrivent aux lots 2 et 4. L'enum est fige en entier des maintenant :
/// ajouter une valeur a un enum Postgres est sans risque, en retirer une ne
/// l'est pas.
enum ThirdPartyKind {
  TENANT
  SUPPLIER
  LANDLORD
  CONTRACTOR
  PARTNER
  EMPLOYEE
  /// Lot 3 de la gestion locative : le proprietaire d'un bien gere. A ne pas
  /// confondre avec LANDLORD, le bailleur d'un terrain de chantier.
  OWNER
}

/// Nature d'un mouvement de compte de tiers.
///
/// ADVANCE_RECEIVED et ADVANCE_APPLIED sont deux valeurs distinctes et
/// symetriques, et non une seule : sans cette distinction, un credit sur le
/// releve ne dirait pas s'il s'agit d'un loyer regle a l'echeance ou d'une
/// avance recue hors echeance. Le PRD (besoin B4) exige que l'imputation
/// d'une avance soit visible sur le releve.
enum ThirdPartyMovementType {
  INSTALLMENT
  PAYMENT
  ADVANCE_RECEIVED
  ADVANCE_APPLIED
  PENALTY
  WAIVER
  ADJUSTMENT
  OPENING_BALANCE
  VOID
  // Gestion locative, lot 3 : le compte courant d'un proprietaire.
  RENT_COLLECTED
  MANAGEMENT_FEE
  MANAGEMENT_FEE_VAT
  EXPENSE
  PAYOUT
  // Lot 10 : retenue a la source sur loyers, depot de garantie conserve.
  WITHHOLDING_TAX
  DEPOSIT_RETAINED
}

enum RentBillingRunStatus {
  RUNNING
  DONE
  FAILED
}

/// Compte de tiers a solde courant.
///
/// Un compte par `TenantClient`, et non par bail : le releve suit la
/// personne, meme si elle change de bail.
model ThirdPartyAccount {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id")
  kind           ThirdPartyKind
  tenantClientId String?        @map("tenant_client_id")
  label          String
  balance        Decimal        @default(0) @db.Decimal(14, 2)
  currency       String         @default("XOF")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantClient TenantClient?        @relation(fields: [tenantClientId], references: [id], onDelete: Cascade)
  movements    ThirdPartyMovement[]
  journalLines JournalEntryLine[]
  // Un pour un : `Supplier.thirdPartyAccountId` est unique. Un compte de
  // tiers de nature SUPPLIER a donc au plus un fournisseur.
  supplier     Supplier?

  landLeases          LandLease[]
  partnershipShares   PartnershipShare[]
  employees           Employee[]
  contractors         Contractor[]
  retentionGuarantees RetentionGuarantee[]

  @@unique([tenantId, kind, tenantClientId])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantClientId])
  @@map("third_party_accounts")
}

/// Une ligne de releve.
///
/// Nait exclusivement d'une piece existante — echeance, paiement, penalite,
/// annulation — ou de la campagne de facturation pour une avance imputee.
/// Jamais de saisie libre : c'est le principe P-2 du PRD, la piece precede
/// l'ecriture.
model ThirdPartyMovement {
  id           String                 @id @default(uuid()) @db.Uuid
  accountId    String                 @map("account_id") @db.Uuid
  tenantId     String                 @map("tenant_id")
  movementDate DateTime               @map("movement_date")
  type         ThirdPartyMovementType
  debit        Decimal?               @db.Decimal(14, 2)
  credit       Decimal?               @db.Decimal(14, 2)
  balanceAfter Decimal                @map("balance_after") @db.Decimal(14, 2)
  label        String
  sourceType   String                 @map("source_type")
  sourceId     String                 @map("source_id")
  leaseId      String?                @map("lease_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")

  account ThirdPartyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease   RentalLease?      @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, type])
  @@index([accountId, movementDate, createdAt])
  @@index([tenantId, movementDate])
  @@index([leaseId])
  @@map("third_party_movements")
}

/// Campagne de facturation mensuelle : « Loyer de septembre 2026 ».
///
/// Un objet par periode et par tenant. L'unicite sur (tenant, annee, mois)
/// fait qu'une relance met a jour la meme campagne au lieu d'en creer une
/// seconde : c'est la moitie de l'idempotence exigee par le besoin B3.
/// L'autre moitie vient de la contrainte unique deja posee sur
/// `rental_installments`.
model RentBillingRun {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id")
  periodYear      Int                  @map("period_year")
  periodMonth     Int                  @map("period_month")
  label           String
  status          RentBillingRunStatus @default(RUNNING)
  startedAt       DateTime             @default(now()) @map("started_at")
  finishedAt      DateTime?            @map("finished_at")
  createdByUserId String               @map("created_by_user_id")
  summary         Json?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId, status])
  @@map("rent_billing_runs")
}

// =============================================================
// FINANCE OPERATIONNELLE — Lot 2, fournisseurs et chantiers
//
// Specification : specs/017-finance-fournisseurs-chantiers/
// Decisions     : docs/finance/PLAN-mise-en-oeuvre.md §2 et §12
//
// Ce lot fait exister l'argent qui SORT, que l'application ne savait pas
// suivre : fournisseurs, factures recues, reglements, pieces de caisse, et le
// chantier comme centre de cout.
//
// Trois principes s'y appliquent, tous poses par le PRD :
//
//   - **La piece precede l'ecriture** (P-2). Aucune ecriture ne nait sans une
//     piece validee ; on ne saisit jamais d'ecriture libre.
//   - **Ce qui est valide ne bouge plus** (P-6). Une piece validee est en
//     lecture seule ; on corrige par une piece d'annulation liee, jamais par
//     modification. D'ou `VoidDocument` et `JournalEntry.voidedByEntryId`.
//   - **Un cout n'est jamais saisi, il est derive** (P-4).
//     `ConstructionSite.actualCost` n'est pas une colonne : c'est la somme des
//     imputations validees et non annulees.
//
// Montants en Decimal(14,2), devise stockee "XOF", affichee « FCFA ».
// =============================================================

enum VoidableDocumentType {
  SUPPLIER_INVOICE
  SUPPLIER_PAYMENT
  CASH_VOUCHER
}

model VoidDocument {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id")
  documentType     VoidableDocumentType @map("document_type")
  documentId       String               @map("document_id") @db.Uuid
  reason           String
  voidedByUserId   String               @map("voided_by_user_id")
  voidedAt         DateTime             @default(now()) @map("voided_at")
  reversingEntryId String?              @map("reversing_entry_id") @db.Uuid

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voidedBy       User          @relation(fields: [voidedByUserId], references: [id])
  reversingEntry JournalEntry? @relation("VoidDocumentReversingEntry", fields: [reversingEntryId], references: [id], onDelete: SetNull)

  @@unique([documentType, documentId])
  @@index([tenantId])
  @@map("void_documents")
}

enum SupplierKind {
  MATERIALS
  SERVICES
  MIXED
}

model Supplier {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @map("tenant_id")
  name                String
  kind                SupplierKind
  // Le contrat l'accepte depuis le debut ; sans colonne, la saisie etait
  // perdue en silence.
  contactName         String?      @map("contact_name")
  contactPhone        String?      @map("contact_phone")
  contactEmail        String?      @map("contact_email")
  // `MaintenanceVendor.id` est un UUID : sans cette annotation, Postgres
  // refuse la cle etrangere (types texte et uuid incompatibles).
  maintenanceVendorId String?      @map("maintenance_vendor_id") @db.Uuid
  thirdPartyAccountId String       @unique @map("third_party_account_id") @db.Uuid
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maintenanceVendor MaintenanceVendor? @relation(fields: [maintenanceVendorId], references: [id], onDelete: SetNull)
  thirdPartyAccount ThirdPartyAccount  @relation(fields: [thirdPartyAccountId], references: [id], onDelete: Cascade)
  invoices          SupplierInvoice[]
  payments          SupplierPayment[]

  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([maintenanceVendorId])
  @@map("suppliers")
}

enum SupplierInvoiceStatus {
  DRAFT
  VALIDATED
  VOIDED
}

model SupplierInvoice {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id")
  supplierId        String                @map("supplier_id") @db.Uuid
  siteId            String?               @map("site_id") @db.Uuid
  /// Bon de commande rapproche, s'il y en a un. Une facture peut arriver sans
  /// bon (achat direct) ; un bon peut etre facture en plusieurs fois.
  purchaseOrderId   String?               @map("purchase_order_id") @db.Uuid
  invoiceDate       DateTime              @map("invoice_date")
  reference         String
  amount            Decimal               @db.Decimal(14, 2)
  currency          String                @default("XOF")
  status            SupplierInvoiceStatus @default(DRAFT)
  journalEntryId    String?               @map("journal_entry_id") @db.Uuid
  createdByUserId   String                @map("created_by_user_id")
  validatedByUserId String?               @map("validated_by_user_id")
  validatedAt       DateTime?             @map("validated_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  site               ConstructionSite?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  purchaseOrder      PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  journalEntry       JournalEntry?               @relation("SupplierInvoiceEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy          User                        @relation("SupplierInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy        User?                       @relation("SupplierInvoiceValidatedBy", fields: [validatedByUserId], references: [id])
  lines              SupplierInvoiceLine[]
  paymentAllocations SupplierPaymentAllocation[]

  // Les imputations ne sont PAS une relation Prisma : `CostAllocation` designe
  // sa piece par le couple (sourceType, sourceId), parce qu'elle peut naitre
  // d'une facture comme d'un bon de caisse. Meme parti pris que
  // `ThirdPartyMovement.sourceId` au lot 1 : on les lit par une requete
  // explicite sur ce couple, jamais par une jointure declaree ici.

  stockReceipts StockMovement[] @relation("StockReceiptInvoice")

  @@unique([tenantId, supplierId, reference])
  @@index([tenantId, status])
  @@index([supplierId])
  @@index([siteId])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  label     String
  amount    Decimal  @db.Decimal(14, 2)
  /// Quantite et prix unitaire, FACULTATIFS (ajoutes le 20 septembre 2026).
  ///
  /// Le montant reste la donnee de reference comptable : ces deux colonnes
  /// sont une aide a la saisie ET une information conservee, jamais une
  /// source de recalcul au moment de la validation. Une prestation ou un
  /// forfait n'a pas de quantite : les deux colonnes restent alors nulles et
  /// le montant est saisi directement, comme avant.
  ///
  /// `quantity` porte trois decimales : on commande 2,5 tonnes de ciment.
  /// Une quantite n'est pas un montant — arrondie au franc, elle vaudrait
  /// zero ; elle passe donc par `roundLineQuantity` (`lib/finance/money.ts`),
  /// jamais par `roundMoneyXof`.
  quantity  Decimal? @db.Decimal(14, 3)
  unitPrice Decimal? @map("unit_price") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("supplier_invoice_lines")
}

model SupplierPayment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id")
  supplierId        String    @map("supplier_id") @db.Uuid
  paymentDate       DateTime  @map("payment_date")
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("XOF")
  method            String
  journalEntryId    String?   @map("journal_entry_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id")
  validatedByUserId String?   @map("validated_by_user_id")
  validatedAt       DateTime? @map("validated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?               @relation("SupplierPaymentEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User                        @relation("SupplierPaymentCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?                       @relation("SupplierPaymentValidatedBy", fields: [validatedByUserId], references: [id])
  allocations  SupplierPaymentAllocation[]

  @@index([tenantId])
  @@index([supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("supplier_payment_allocations")
}

enum ConstructionSiteStatus {
  PLANNED
  IN_PROGRESS
  SUSPENDED
  CLOSED
}

model ConstructionSite {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @map("tenant_id")
  name                   String
  // Facultatives, et c'est deliberé. Un chantier se cree parfois avant que
  // sa zone ou sa date de demarrage ne soient arretees. Les exiger obligeait a
  // combler par une chaine vide et la date du jour — une valeur inventee est
  // pire qu'une valeur absente, parce qu'elle se lit comme une vraie.
  zone                   String?
  propertyId             String?                  @map("property_id")
  /// Bail de terrain dont depend ce chantier, s'il y en a un.
  ///
  /// La colonne existait depuis le lot 2 sans modele ni cle etrangere : une
  /// amorce posee en prevision du lot 4. Elle en a une desormais.
  landLeaseId            String?                  @map("land_lease_id") @db.Uuid
  managerId              String?                  @map("manager_id")
  status                 ConstructionSiteStatus   @default(PLANNED)
  startDate              DateTime?                @map("start_date")
  plannedEndDate         DateTime?                @map("planned_end_date")
  progressPercent        Int                      @default(0) @map("progress_percent")
  closedAt               DateTime?                @map("closed_at")
  finalCost              Decimal?                 @map("final_cost") @db.Decimal(14, 2)
  budgetThresholdPercent Int?                     @map("budget_threshold_percent")
  stockEnabledAt         DateTime?                @map("stock_enabled_at")
  /// Qui a prononce la cloture. Nul tant que le chantier est ouvert.
  closedByUserId         String?                  @map("closed_by_user_id")
  /// Comment le cout total se repartit entre les lots de ce chantier.
  ///
  /// Nul tant qu'aucun lot n'existe : un chantier qui ne produit rien a
  /// vendre n'a pas de cle de repartition, et lui en imposer une par defaut
  /// laisserait croire qu'un choix a ete fait.
  lotAllocationMethod    SiteLotAllocationMethod? @map("lot_allocation_method")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property        Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  manager         User?               @relation("ConstructionSiteManager", fields: [managerId], references: [id], onDelete: SetNull)
  allocations     CostAllocation[]
  invoices        SupplierInvoice[]
  cashVouchers    CashVoucher[]
  workPrograms    WorkProgram[]
  budgets         SiteBudget[]
  purchaseOrders  PurchaseOrder[]
  progressEntries SiteProgressEntry[]
  budgetAlerts    SiteBudgetAlert[]
  landLease       LandLease?          @relation(fields: [landLeaseId], references: [id], onDelete: SetNull)

  salaryNotes         SalaryNote[]
  contractorContracts ContractorContract[]
  closedBy            User?                @relation("ConstructionSiteClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  lots                SiteLot[]

  stockLocation  StockLocation?
  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([propertyId])
  @@map("construction_sites")
}

/// Poste de depense d'une agence.
///
/// `position` porte l'ordre d'affichage voulu par la gestionnaire, que le
/// contrat promet. Sans colonne, il se deduisait de l'ordre de creation, si
/// bien qu'un poste ajoute apres coup ne pouvait jamais etre remonte.
model CostCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id")
  label     String
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  /// Compte de charge du plan comptable operationnel, s'il y en a un.
  ///
  /// Sans lui, toute depense de chantier frappait le MEME compte, quel que
  /// soit le poste : le grand livre ne distinguait pas le ciment de la
  /// main-d'oeuvre. L'imputation analytique (ce poste-ci) et l'imputation
  /// comptable etaient deux mondes separes. C'est la limite consignee au
  /// lot 2, promise au lot 3, et tenue ici.
  ///
  /// Facultatif a dessein : un poste sans compte retombe sur le compte de
  /// charge par defaut, exactement comme avant. Rien de ce qui existe ne
  /// change de comportement du seul fait de cette colonne.
  chartOfAccountId String?          @map("chart_of_account_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations      CostAllocation[]
  cashVouchers     CashVoucher[]

  budgetLines         SiteBudgetLine[]
  amendmentLines      BudgetAmendmentLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  landLeases          LandLease[]
  chartOfAccount      ChartOfAccount?       @relation(fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  salaryNotes         SalaryNote[]
  contractorContracts ContractorContract[]

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("cost_categories")
}

enum CostAllocationSourceType {
  SUPPLIER_INVOICE
  CASH_VOUCHER
  /// Lot 5. Une SORTIE de magasin impute le materiau au cout du chantier.
  /// C'est le principe P-7 : des que le stock est actif, le cout des
  /// materiaux vient de la sortie et non de la facture.
  STOCK_ISSUE
  /// Lot 4, sous-lot 4. Une situation d'avancement validee s'impute au cout
  /// du chantier de son marche : c'est le travail du tacheron, et il coute.
  PROGRESS_STATEMENT
  /// Lot 4, sous-lot 3. Une note de salaire rattachee a un chantier s'impute
  /// a son cout : c'est le besoin P9 du PRD, et c'est ce qui fait qu'un
  /// chantier connait sa main-d'oeuvre.
  SALARY_NOTE
  /// Lot 4. Sans cette valeur, la constatation mensuelle d'un loyer de
  /// terrain ne pouvait produire aucune imputation, et le loyer n'entrait
  /// donc JAMAIS dans le cout reel du chantier — ce qui vidait le sous-lot
  /// de son sens, puisque c'est exactement ce que le PRD demande.
  ///
  /// Le schema avait ete gele a moitie : `ThirdPartyKind` portait deja
  /// LANDLORD et les comptes 486/613 etaient semes, mais cette enumeration-ci
  /// et les deux suivantes avaient ete oubliees. Releve par l'agent du
  /// service dans sa rubrique d'hypotheses.
  LAND_LEASE_ACCRUAL
}

model CostAllocation {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @map("tenant_id")
  siteId         String                   @map("site_id") @db.Uuid
  costCategoryId String                   @map("cost_category_id") @db.Uuid
  sourceType     CostAllocationSourceType @map("source_type")
  sourceId       String                   @map("source_id") @db.Uuid
  amount         Decimal                  @db.Decimal(14, 2)
  validatedAt    DateTime?                @map("validated_at")
  voidedAt       DateTime?                @map("voided_at")
  createdAt      DateTime                 @default(now()) @map("created_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site         ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  costCategory CostCategory     @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([siteId, validatedAt])
  @@index([sourceType, sourceId])
  @@map("cost_allocations")
}

model CashVoucher {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id")
  // Nuls tant que la piece est un brouillon. Le numero est attribue a la
  // VALIDATION, pas a la saisie : un brouillon abandonne ne doit pas consommer
  // un numero et laisser un trou dans le carnet, ce qu'un controleur
  // comptable releverait. Decision du 19 septembre 2026, arbitree par la
  // cliente apres le rapport du lot 2 (§6).
  //
  // L'index unique ci-dessous reste valable : PostgreSQL considere deux NULL
  // comme distincts, si bien que les brouillons coexistent sans se gener.
  voucherNumber     Int?      @map("voucher_number")
  voucherYear       Int?      @map("voucher_year")
  siteId            String    @map("site_id") @db.Uuid
  costCategoryId    String    @map("cost_category_id") @db.Uuid
  beneficiaryName   String    @map("beneficiary_name")
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("XOF")
  reason            String
  voucherDate       DateTime  @map("voucher_date")
  journalEntryId    String?   @map("journal_entry_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id")
  validatedByUserId String?   @map("validated_by_user_id")
  validatedAt       DateTime? @map("validated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site         ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  costCategory CostCategory     @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?    @relation("CashVoucherEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("CashVoucherCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?            @relation("CashVoucherValidatedBy", fields: [validatedByUserId], references: [id])

  @@unique([tenantId, voucherYear, voucherNumber])
  @@index([tenantId])
  @@index([siteId])
  @@map("cash_vouchers")
}

// ===========================================================================
// LOT 3 — Budget de chantier, engagements, pilotage (PRD E5)
// ===========================================================================
//
// Deux ecarts assumes avec le plan (docs/finance/PLAN-mise-en-oeuvre.md §7),
// tous deux constates en ouvrant le lot et documentes ici plutot qu'ailleurs,
// parce que c'est ici qu'on les lit.
//
// 1. LE PLAN PREVOYAIT DE REUTILISER `BudgetLineItem`. On ne le fait pas.
//    Ce modele porte `distributionKey` NOT NULL (une cle de repartition des
//    charges entre lots de copropriete, qui n'a aucun sens pour un chantier),
//    `category` en chaine libre la ou il nous faut une cle etrangere vers
//    `CostCategory`, et surtout `amountActual` : un REALISE STOCKE. Or toute
//    la doctrine des lots precedents est qu'un cout se derive et ne se saisit
//    jamais (principe P-4 du PRD) ; c'est meme le defaut qu'on a corrige au
//    lot 2 sur `WorkProgram.actualCost`. Reutiliser ce modele aurait fait
//    entrer ce defaut dans le module neuf, et aurait donne une table dont la
//    moitie des colonnes n'a de sens que pour l'un de ses deux parents.
//    `SiteBudgetLine` est donc un modele distinct. Le partage voulu par le
//    plan — le composant de saisie de lignes — reste possible : partager un
//    composant React n'oblige pas a partager une table.
//
// 2. LE PLAN PREVOYAIT DE NOTIFIER VIA `NotificationEvent`. Ce modele
//    n'existe pas. Les seules notifications du depot sont le courriel et
//    WhatsApp, configures par agence ; il n'y a aucune notification dans
//    l'application, que le PRD exige pourtant pour l'alerte de depassement.
//    Plutot que de batir un systeme de notification generique dont rien
//    d'autre ne se servirait, l'alerte est un ENREGISTREMENT de premiere
//    classe (`SiteBudgetAlert`) : datee, motivee par un seuil franchi,
//    acquittable, et lisible depuis le tableau de bord. C'est ce que le PRD
//    demande, sans inventer une charpente.

/// Budget d'un chantier, ligne a ligne par poste de depense.
///
/// Un chantier n'a qu'un seul budget VALIDE a la fois — c'est le budget
/// initial, au sens du PRD. Les brouillons, eux, peuvent coexister : on
/// prepare, on compare, on valide.
///
/// Le montant total n'a PAS de colonne : il est la somme de ses lignes. Un
/// total stocke est un total qui se desynchronise.
model SiteBudget {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id")
  siteId            String           @map("site_id") @db.Uuid
  label             String
  status            SiteBudgetStatus @default(DRAFT)
  validatedAt       DateTime?        @map("validated_at")
  validatedByUserId String?          @map("validated_by_user_id")
  currency          String           @default("XOF")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site        ConstructionSite  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  validatedBy User?             @relation("SiteBudgetValidatedBy", fields: [validatedByUserId], references: [id])
  lines       SiteBudgetLine[]
  amendments  BudgetAmendment[]
  alerts      SiteBudgetAlert[]

  @@index([tenantId])
  @@index([siteId])
  // L'unicite « un seul budget valide par chantier » est un index partiel
  // (WHERE status = 'VALIDATED') que le DSL Prisma ne sait pas exprimer : il
  // est pose en SQL brut dans la migration, comme au lot 2 pour le plan
  // comptable.
  @@map("site_budgets")
}

/// Une ligne de budget : un poste de depense, un montant prevu.
///
/// Pas de `amountActual` ici, a dessein : le realise d'un poste est la somme
/// de ses imputations validees et non annulees, calculee a la lecture.
model SiteBudgetLine {
  id             String   @id @default(uuid()) @db.Uuid
  budgetId       String   @map("budget_id") @db.Uuid
  costCategoryId String   @map("cost_category_id") @db.Uuid
  label          String
  amountForecast Decimal  @map("amount_forecast") @db.Decimal(14, 2)
  /// Quantite et prix unitaire, FACULTATIFS (ajoutes le 20 septembre 2026).
  ///
  /// Le montant reste la donnee de reference comptable : ces deux colonnes
  /// sont une aide a la saisie ET une information conservee, jamais une
  /// source de recalcul au moment de la validation. Une prestation ou un
  /// forfait n'a pas de quantite : les deux colonnes restent alors nulles et
  /// le montant est saisi directement, comme avant.
  ///
  /// `quantity` porte trois decimales : on commande 2,5 tonnes de ciment.
  /// Une quantite n'est pas un montant — arrondie au franc, elle vaudrait
  /// zero ; elle passe donc par `roundLineQuantity` (`lib/finance/money.ts`),
  /// jamais par `roundMoneyXof`.
  quantity       Decimal? @db.Decimal(14, 3)
  unitPrice      Decimal? @map("unit_price") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  budget       SiteBudget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCategory CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  @@index([budgetId])
  @@map("site_budget_lines")
}

/// Avenant a un budget valide.
///
/// On ne modifie pas un budget valide : on l'amende. Le budget revise vaut
/// l'initial plus la somme des avenants VALIDES — un avenant en brouillon ne
/// compte pour rien, exactement comme une piece en brouillon au lot 2.
///
/// Un avenant ne figure pas dans la file de validation partagee du lot 2 :
/// celle-ci ne montre que les pieces qui deplacent de l'argent (facture,
/// reglement, piece de caisse). Un avenant deplace une PREVISION. Il se valide
/// donc depuis l'ecran du budget, par le meme droit.
model BudgetAmendment {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id")
  budgetId          String           @map("budget_id") @db.Uuid
  amendmentDate     DateTime         @map("amendment_date")
  /// Obligatoire. Un avenant sans motif est un chiffre qu'on ne saura pas
  /// expliquer six mois plus tard.
  reason            String
  status            SiteBudgetStatus @default(DRAFT)
  createdByUserId   String           @map("created_by_user_id")
  validatedByUserId String?          @map("validated_by_user_id")
  validatedAt       DateTime?        @map("validated_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget      SiteBudget            @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("BudgetAmendmentCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy User?                 @relation("BudgetAmendmentValidatedBy", fields: [validatedByUserId], references: [id])
  lines       BudgetAmendmentLine[]

  @@index([tenantId])
  @@index([budgetId])
  @@map("budget_amendments")
}

/// Une ligne d'avenant : un poste, un ecart SIGNE.
///
/// `amountDelta` peut etre negatif : un avenant reduit parfois une enveloppe.
model BudgetAmendmentLine {
  id             String   @id @default(uuid()) @db.Uuid
  amendmentId    String   @map("amendment_id") @db.Uuid
  costCategoryId String   @map("cost_category_id") @db.Uuid
  amountDelta    Decimal  @map("amount_delta") @db.Decimal(14, 2)
  /// Quantite et prix unitaire, FACULTATIFS (ajoutes le 20 septembre 2026).
  ///
  /// Meme parti pris que sur les trois autres lignes : aide a la saisie et
  /// information conservee, jamais un recalcul serveur. Particularite de
  /// l'avenant : `amountDelta` est SIGNE, et une quantite negative n'a aucun
  /// sens. C'est donc `unitPrice` qui porte le signe — une reduction
  /// d'enveloppe se saisit avec un prix unitaire negatif, ou, plus
  /// simplement, en ecart direct sans quantite ni prix unitaire.
  quantity       Decimal? @db.Decimal(14, 3)
  unitPrice      Decimal? @map("unit_price") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  amendment    BudgetAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  costCategory CostCategory    @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  @@index([amendmentId])
  @@map("budget_amendment_lines")
}

/// Bon de commande passe a un fournisseur pour un chantier.
///
/// `status` ne porte QUE le cycle de vie qu'on decide : brouillon, emis,
/// annule. L'etat de facturation — pas facture, partiellement facture, solde —
/// n'est PAS stocke : c'est une fonction des factures rapprochees, calculee a
/// la lecture. Deux choses orthogonales, deux traitements differents ; melanger
/// les deux dans une colonne, c'est se donner une valeur qui derive des que
/// quelqu'un valide une facture par un autre chemin.
model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id")
  siteId             String              @map("site_id") @db.Uuid
  supplierId         String              @map("supplier_id") @db.Uuid
  reference          String
  orderDate          DateTime            @map("order_date")
  status             PurchaseOrderStatus @default(DRAFT)
  currency           String              @default("XOF")
  createdByUserId    String              @map("created_by_user_id")
  issuedByUserId     String?             @map("issued_by_user_id")
  issuedAt           DateTime?           @map("issued_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  /// Motif de l'annulation. Obligatoire des lors qu'on annule.
  ///
  /// Manquait au gel : `CancelPurchaseOrderTx` recevait un motif que rien ne
  /// stockait, ce que deux agents ont releve independamment. Annuler un bon
  /// est un geste irreversible sur un engagement ; le lot 2 exige un motif
  /// pour toute annulation de piece, et il n'y a pas de raison de faire
  /// autrement ici.
  cancellationReason String?             @map("cancellation_reason")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      ConstructionSite    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])
  issuedBy  User?               @relation("PurchaseOrderIssuedBy", fields: [issuedByUserId], references: [id])
  lines     PurchaseOrderLine[]
  invoices  SupplierInvoice[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([siteId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  costCategoryId String   @map("cost_category_id") @db.Uuid
  label          String
  amount         Decimal  @db.Decimal(14, 2)
  /// Quantite et prix unitaire, FACULTATIFS (ajoutes le 20 septembre 2026).
  ///
  /// Le montant reste la donnee de reference comptable : ces deux colonnes
  /// sont une aide a la saisie ET une information conservee, jamais une
  /// source de recalcul au moment de la validation. Une prestation ou un
  /// forfait n'a pas de quantite : les deux colonnes restent alors nulles et
  /// le montant est saisi directement, comme avant.
  ///
  /// `quantity` porte trois decimales : on commande 2,5 tonnes de ciment.
  /// Une quantite n'est pas un montant — arrondie au franc, elle vaudrait
  /// zero ; elle passe donc par `roundLineQuantity` (`lib/finance/money.ts`),
  /// jamais par `roundMoneyXof`.
  quantity       Decimal? @db.Decimal(14, 3)
  unitPrice      Decimal? @map("unit_price") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  costCategory CostCategory  @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("purchase_order_lines")
}

/// Avancement physique d'un chantier, date, conserve.
///
/// `ConstructionSite.progressPercent` devient une COPIE de la derniere saisie,
/// tenue par le service — meme parti pris que `WorkProgram.actualCost` au
/// lot 2, et pour la meme raison : les ecrans du lot 2 lisent deja cette
/// colonne, et la faire disparaitre les casserait. Le controleur d'invariants
/// verifie que la copie dit bien ce que dit la derniere saisie.
model SiteProgressEntry {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id")
  siteId          String   @map("site_id") @db.Uuid
  entryDate       DateTime @map("entry_date")
  percent         Int
  note            String?
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User             @relation("SiteProgressEntryCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@index([siteId, entryDate])
  @@map("site_progress_entries")
}

/// Alerte de depassement de budget, levee sur l'ENGAGE.
///
/// Voir l'ecart n°2 en tete de cette section : c'est la notification « dans
/// l'application » que le PRD demande, sans charpente de notification.
///
/// Levee a chaque validation de piece et a chaque emission de bon, quand
/// l'engage franchit le seuil du chantier
/// (`ConstructionSite.budgetThresholdPercent`). Au plus une alerte NON
/// ACQUITTEE par budget : sans cela, chaque piece validee en produirait une
/// nouvelle et l'ecran se remplirait de la meme alerte.
model SiteBudgetAlert {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id")
  siteId               String    @map("site_id") @db.Uuid
  budgetId             String    @map("budget_id") @db.Uuid
  /// Le seuil qui etait configure au moment ou l'alerte est nee. Fige, pour
  /// qu'un changement de seuil ne reecrive pas l'histoire.
  thresholdPercent     Int       @map("threshold_percent")
  engagedAmount        Decimal   @map("engaged_amount") @db.Decimal(14, 2)
  budgetAmount         Decimal   @map("budget_amount") @db.Decimal(14, 2)
  raisedAt             DateTime  @default(now()) @map("raised_at")
  acknowledgedAt       DateTime? @map("acknowledged_at")
  acknowledgedByUserId String?   @map("acknowledged_by_user_id")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  budget         SiteBudget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  acknowledgedBy User?            @relation("SiteBudgetAlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id])

  @@index([tenantId])
  @@index([siteId])
  @@map("site_budget_alerts")
}

/// Cycle de vie decide d'un bon de commande.
///
/// L'etat de FACTURATION (pas facture / partiellement / solde) n'est pas ici :
/// il se derive des factures rapprochees. Voir l'en-tete de `PurchaseOrder`.
enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// Cycle d'un budget de chantier et de ses avenants : brouillon, puis valide.
///
/// Enumeration DISTINCTE de `BudgetStatus`, qui decrit le cycle d'un budget de
/// COPROPRIETE (DRAFT, APPROVED, REVISED, CLOSED). Deux de ses valeurs n'ont
/// aucun sens ici -- un budget de chantier ne se « revise » pas, il s'amende,
/// et il ne se « cloture » pas, c'est le chantier qui se cloture -- et celle
/// dont on a besoin y manque. Reutiliser cette enumeration aurait fait entrer
/// dans le module trois etats inatteignables et un vocabulaire d'emprunt.
enum SiteBudgetStatus {
  DRAFT
  VALIDATED
}

// ===========================================================================
// LOT 4 — Baux de terrain (PRD E7, besoin B10)
// ===========================================================================
//
// LE BESOIN, ET POURQUOI IL EST LE SEUL « MUST » DU LOT 4.
//
// L'entreprise loue des terrains pour y batir. Elle paie le bailleur UNE FOIS
// PAR AN, d'avance, et consomme cette avance mois apres mois. Sans ce
// mecanisme, un chantier sur terrain loue porte soit la totalite du loyer le
// mois du paiement — et son cout devient illisible — soit rien du tout.
//
// LE CYCLE, EN TROIS TEMPS.
//
//   1. Le bail est enregistre, et ouvre le compte de tiers du bailleur.
//   2. Le paiement annuel est saisi puis valide : l'avance est versee, et le
//      compte du bailleur devient DEBITEUR de ce qu'il nous doit encore en
//      jouissance du terrain.
//   3. Chaque mois, un douzieme est CONSTATE : la charge nait, le compte du
//      bailleur remonte d'autant, et il atteint zero au douzieme mois.
//
// LES DEUX VUES, comme aux lots 1 et 2. Le compte de tiers porte la vue de la
// gestionnaire — « combien ai-je paie d'avance a ce bailleur, combien
// reste-t-il a consommer ». Le journal porte la vue comptable : le paiement
// debite les charges constatees d'avance (486), la constatation mensuelle les
// vire aux locations (613). Les deux ne se contredisent jamais parce qu'elles
// naissent de la meme piece, dans la meme transaction.

/// Bail de terrain ou l'entreprise est LOCATAIRE.
///
/// A ne pas confondre avec `Lease`, le bail d'habitation ou l'agence gere pour
/// le compte d'un proprietaire : ici l'entreprise paie, elle n'encaisse pas.
model LandLease {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id")
  /// Compte de tiers du bailleur, ouvert avec le bail.
  ///
  /// Un bail sans compte ne pourrait rien devoir, et le premier paiement le
  /// trouverait manquant — meme raison qu'au lot 2 pour le fournisseur.
  landlordAccountId String    @map("landlord_account_id") @db.Uuid
  landlordName      String    @map("landlord_name")
  /// Ce qu'on loue, en clair : « Terrain de Nongo, 800 m2 ».
  landLabel         String    @map("land_label")
  /// Montant ANNUEL. Le douzieme mensuel s'en deduit, il ne se stocke pas.
  annualAmount      Decimal   @map("annual_amount") @db.Decimal(14, 2)
  /// Poste de depense auquel le loyer s'impute dans le cout des chantiers.
  ///
  /// Obligatoire, et choisi a la creation du bail. `CostAllocation` exige un
  /// poste : sans lui, la constatation mensuelle ne pourrait produire aucune
  /// imputation et le loyer n'entrerait pas dans le cout du chantier.
  ///
  /// Le demander plutot que de deviner : c'est la gestionnaire qui sait si le
  /// loyer d'un terrain releve des « Divers » ou d'un poste qu'elle a cree
  /// pour cela. Un poste devine se lirait comme un choix, et personne ne
  /// saurait qu'il n'en etait pas un.
  costCategoryId    String    @map("cost_category_id") @db.Uuid
  currency          String    @default("XOF")
  startDate         DateTime  @map("start_date")
  /// Nulle en tacite reconduction, ce qui est le cas courant a Conakry.
  endDate           DateTime? @map("end_date")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  landlordAccount ThirdPartyAccount  @relation(fields: [landlordAccountId], references: [id], onDelete: Restrict)
  costCategory    CostCategory       @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  sites           ConstructionSite[]
  payments        LandLeasePayment[]
  accruals        LandLeaseAccrual[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("land_leases")
}

/// Paiement au bailleur, annuel et d'avance.
///
/// Brouillon a la saisie, comme toute piece depuis le lot 2 : c'est la
/// validation qui ecrit, jamais la saisie.
model LandLeasePayment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id")
  landLeaseId       String    @map("land_lease_id") @db.Uuid
  paymentDate       DateTime  @map("payment_date")
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @default("XOF")
  /// Periode couverte, pour qu'on sache ce qu'on a paye.
  coverageStartDate DateTime  @map("coverage_start_date")
  coverageEndDate   DateTime  @map("coverage_end_date")
  journalEntryId    String?   @map("journal_entry_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id")
  validatedByUserId String?   @map("validated_by_user_id")
  validatedAt       DateTime? @map("validated_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  landLease    LandLease     @relation(fields: [landLeaseId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation("LandLeasePaymentEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("LandLeasePaymentCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?         @relation("LandLeasePaymentValidatedBy", fields: [validatedByUserId], references: [id])

  @@index([tenantId])
  @@index([landLeaseId])
  @@map("land_lease_payments")
}

/// Constatation mensuelle d'un douzieme du loyer annuel.
///
/// POSEE PAR UN TRAVAIL PROGRAMME, PAS PAR UNE PERSONNE. Elle n'a donc pas
/// d'etat brouillon : personne ne « saisit » une constatation, et il n'y
/// aurait personne pour la valider. Elle nait validee, avec son ecriture, dans
/// une seule transaction — le principe P-2 est respecte (la piece precede
/// l'ecriture), seul le cycle brouillon/valide ne s'applique pas.
///
/// IDEMPOTENTE PAR CONSTRUCTION. L'unicite `(bail, annee, mois)` est la
/// garantie que le travail peut se rejouer sans rien doubler : c'est la meme
/// discipline que la campagne de facturation du lot 1, qui se rejoue sans
/// refacturer.
model LandLeaseAccrual {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id")
  landLeaseId    String   @map("land_lease_id") @db.Uuid
  periodYear     Int      @map("period_year")
  periodMonth    Int      @map("period_month")
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("XOF")
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  landLease    LandLease     @relation(fields: [landLeaseId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation("LandLeaseAccrualEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([landLeaseId, periodYear, periodMonth])
  @@index([tenantId])
  @@map("land_lease_accruals")
}

// ===========================================================================
// LOT 4, sous-lot 2 — Associations (PRD E7, besoin B9)
// ===========================================================================
//
// LE BESOIN. Certains biens appartiennent a plusieurs associes, chacun pour
// une quote-part. L'agence encaisse le loyer entier du locataire, puis doit a
// chaque associe sa part.
//
// CE QUE LE LOCATAIRE DOIT NE CHANGE PAS. Il a signe un bail pour un montant,
// il doit ce montant, et son compte de tiers porte toujours le loyer ENTIER.
// Ce qui se repartit, c'est le PRODUIT, pas la creance. Le PRD dit que « le
// compte loyer principal ne recoit que la part de l'entreprise » ; cette
// phrase suppose une comptabilisation du loyer en produit que le lot 1 n'a
// deliberement pas construite — la campagne de facturation n'ecrit aucune
// ecriture comptable, seulement un mouvement de compte de tiers. La part de
// l'entreprise est donc, ici, simplement ce qui reste une fois les parts des
// associes constatees. A confirmer avec la cliente ; consigne comme tel.
//
// L'IDEMPOTENCE EST HERITEE. La campagne de facturation du lot 1 se rejoue
// sans refacturer ; la ventilation doit en faire autant, d'ou l'unicite
// (part, echeance) sur la constatation.

/// Une association d'associes qui detiennent des biens ensemble.
model Partnership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id")
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shares        PartnershipShare[]
  properties    Property[]
  distributions PartnershipDistribution[]

  @@index([tenantId])
  @@map("partnerships")
}

/// La quote-part d'un associe, et son compte de tiers.
///
/// Le compte nait avec la part : un associe sans compte ne pourrait rien
/// recevoir, et la premiere ventilation le trouverait manquant — meme raison
/// qu'au lot 2 pour le fournisseur.
model PartnershipShare {
  id               String   @id @default(uuid()) @db.Uuid
  partnershipId    String   @map("partnership_id") @db.Uuid
  partnerAccountId String   @map("partner_account_id") @db.Uuid
  partnerName      String   @map("partner_name")
  /// En pourcentage, deux decimales. La somme des parts d'une association ne
  /// peut pas depasser cent ; ce qui reste est la part de l'entreprise.
  sharePercent     Decimal  @map("share_percent") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  partnership    Partnership               @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  partnerAccount ThirdPartyAccount         @relation(fields: [partnerAccountId], references: [id], onDelete: Restrict)
  distributions  PartnershipDistribution[]

  @@unique([partnershipId, partnerAccountId])
  @@index([partnershipId])
  @@map("partnership_shares")
}

/// La part d'un associe sur une echeance de loyer, constatee a la facturation.
///
/// IDEMPOTENTE PAR CONSTRUCTION. L'unicite (part, echeance) garantit qu'une
/// campagne rejouee ne double aucune ventilation, exactement comme elle ne
/// refacture aucun loyer. C'est la meme discipline que la constatation
/// mensuelle d'un loyer de terrain.
model PartnershipDistribution {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id")
  partnershipId       String   @map("partnership_id") @db.Uuid
  partnershipShareId  String   @map("partnership_share_id") @db.Uuid
  rentalInstallmentId String   @map("rental_installment_id") @db.Uuid
  periodYear          Int      @map("period_year")
  periodMonth         Int      @map("period_month")
  /// La part de cet associe sur cette echeance. Le reliquat d'arrondi va au
  /// premier associe, sans quoi la somme des parts ne vaudrait pas le produit
  /// reparti.
  amount              Decimal  @db.Decimal(14, 2)
  currency            String   @default("XOF")
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partnership       Partnership       @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  partnershipShare  PartnershipShare  @relation(fields: [partnershipShareId], references: [id], onDelete: Cascade)
  rentalInstallment RentalInstallment @relation(fields: [rentalInstallmentId], references: [id], onDelete: Cascade)

  @@unique([partnershipShareId, rentalInstallmentId])
  @@index([tenantId])
  @@index([partnershipId, periodYear, periodMonth])
  @@map("partnership_distributions")
}

// ===========================================================================
// LOT 4, sous-lot 3 — Salaires (PRD E8, besoins B11 et P9)
// ===========================================================================
//
// AUCUN CALCUL SOCIAL, et c'est une exigence du PRD, pas un raccourci. Le
// module constate une depense et une dette envers un salarie ; il ne calcule
// ni cotisation, ni retenue, ni net a payer. Ce qui est saisi est ce qui sera
// verse.
//
// LE CYCLE, calque sur celui du fournisseur au lot 2, parce que c'est le meme
// mouvement d'argent : une piece cree la dette, une autre l'eteint.
//
//   1. La note de salaire est saisie, puis validee : la charge nait, et le
//      compte de l'employe devient crediteur de ce qu'on lui doit.
//   2. Quand la note porte un chantier, la charge s'impute a son cout — c'est
//      le besoin P9, et c'est ce qui fait qu'un chantier connait sa
//      main-d'oeuvre.
//   3. Le reglement eteint la dette.
//
// UNE NOTE PAR EMPLOYE ET PAR MOIS. L'unicite l'impose : sans elle, une double
// saisie ferait payer deux fois le meme mois, et personne ne s'en apercevrait
// avant que le salarie ne le signale.

/// Un salarie de l'entreprise, et son compte de tiers.
///
/// Distinct de `User`, qui est un compte d'acces a l'application : un macon
/// n'ouvre pas l'application, et un comptable qui l'ouvre n'est pas
/// forcement paye par ce module.
model Employee {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id")
  fullName            String   @map("full_name")
  /// Ce qu'il fait, en clair : « Macon », « Chef de chantier ». Libre.
  role                String?
  thirdPartyAccountId String   @map("third_party_account_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thirdPartyAccount ThirdPartyAccount @relation(fields: [thirdPartyAccountId], references: [id], onDelete: Restrict)
  salaryNotes       SalaryNote[]
  salaryPayments    SalaryPayment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("employees")
}

/// La note de salaire d'un mois, pour un employe.
model SalaryNote {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id")
  employeeId        String                @map("employee_id") @db.Uuid
  periodYear        Int                   @map("period_year")
  periodMonth       Int                   @map("period_month")
  amount            Decimal               @db.Decimal(14, 2)
  currency          String                @default("XOF")
  /// Chantier auquel ce salaire se rattache, s'il y en a un.
  ///
  /// Facultatif : un comptable d'agence n'est rattache a aucun chantier. Quand
  /// il est renseigne, la charge s'impute au cout du chantier (besoin P9).
  siteId            String?               @map("site_id") @db.Uuid
  /// Poste de depense de l'imputation. Exige des qu'un chantier est renseigne.
  ///
  /// Le PRD dit « poste main-d'oeuvre ». On ne le devine PAS depuis un
  /// libelle : les postes sont propres a chaque agence et librement
  /// renommables, et resoudre par le texte casserait le jour ou quelqu'un
  /// ecrit « Main d'oeuvre » sans apostrophe. L'ecran le presente
  /// pre-selectionne ; le domaine, lui, l'exige.
  costCategoryId    String?               @map("cost_category_id") @db.Uuid
  status            SupplierInvoiceStatus @default(DRAFT)
  journalEntryId    String?               @map("journal_entry_id") @db.Uuid
  createdByUserId   String                @map("created_by_user_id")
  validatedByUserId String?               @map("validated_by_user_id")
  validatedAt       DateTime?             @map("validated_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site         ConstructionSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  costCategory CostCategory?     @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?     @relation("SalaryNoteEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("SalaryNoteCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?             @relation("SalaryNoteValidatedBy", fields: [validatedByUserId], references: [id])

  /// Une note par employe et par mois. Sans cette contrainte, une double
  /// saisie ferait payer deux fois le meme mois.
  @@unique([employeeId, periodYear, periodMonth])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId])
  @@map("salary_notes")
}

/// Le reglement d'un salarie : ce qui eteint la dette.
///
/// Sans affectation a des notes precises, contrairement au reglement
/// fournisseur du lot 2 : on paie un salarie, pas une facture. Le solde de son
/// compte dit ce qui lui reste du, et c'est la seule question qu'on se pose.
model SalaryPayment {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id")
  employeeId        String                @map("employee_id") @db.Uuid
  paymentDate       DateTime              @map("payment_date")
  amount            Decimal               @db.Decimal(14, 2)
  currency          String                @default("XOF")
  status            SupplierInvoiceStatus @default(DRAFT)
  journalEntryId    String?               @map("journal_entry_id") @db.Uuid
  createdByUserId   String                @map("created_by_user_id")
  validatedByUserId String?               @map("validated_by_user_id")
  validatedAt       DateTime?             @map("validated_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation("SalaryPaymentEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("SalaryPaymentCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?         @relation("SalaryPaymentValidatedBy", fields: [validatedByUserId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("salary_payments")
}

// ===========================================================================
// LOT 4, sous-lot 4 — Tacherons (PRD E8, besoin P10)
// ===========================================================================
//
// UN TACHERON N'EST PAS UN FOURNISSEUR, meme s'il lui ressemble. Il ne
// facture pas : il convient d'un MARCHE pour un ouvrage, puis presente des
// SITUATIONS d'avancement a mesure qu'il avance. Le solde de son marche est
// ce qui reste a executer ; le solde de son compte est ce qu'on lui doit.
// Deux soldes distincts, et les confondre est l'erreur a ne pas faire.
//
//   marche restant = montant convenu − situations validees
//   ce qu'on lui doit = situations validees − reglements
//
// LES ACOMPTES SE DEDUISENT TOUT SEULS. Un reglement verse avant toute
// situation rend le compte debiteur ; la premiere situation le ramene vers
// zero. C'est exactement le mecanisme de l'acompte fournisseur du lot 2, et il
// n'y a rien de plus a modeliser — le PRD parle d'« acomptes deduits », et ils
// le sont par le solde lui-meme.
//
// UN DEPASSEMENT DE MARCHE N'EST PAS REFUSE. Si le tacheron a fait davantage,
// la situation dit ce qui a ete fait : la refuser empecherait d'enregistrer un
// travail reel, et c'est la meme erreur que bloquer une facture parce qu'un
// budget est depasse — leçon deja tiree au lot 3 avec l'alerte. Le
// depassement est EXPOSE, pas interdit.

/// Un tacheron, et son compte de tiers.
model Contractor {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id")
  fullName            String   @map("full_name")
  /// Son corps de metier, en clair : « Macon », « Carreleur ». Libre.
  trade               String?
  thirdPartyAccountId String   @map("third_party_account_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thirdPartyAccount ThirdPartyAccount    @relation(fields: [thirdPartyAccountId], references: [id], onDelete: Restrict)
  contracts         ContractorContract[]
  payments          ContractorPayment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("contractors")
}

/// Le marche convenu avec un tacheron, sur un chantier et un poste.
model ContractorContract {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id")
  contractorId   String   @map("contractor_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  /// Poste de depense auquel les situations s'imputeront. Exige, jamais
  /// devine : les postes sont propres a chaque agence et renommables.
  costCategoryId String   @map("cost_category_id") @db.Uuid
  reference      String
  /// Le montant convenu. Ce qui reste a executer s'en deduit, il ne se
  /// stocke pas.
  agreedAmount   Decimal  @map("agreed_amount") @db.Decimal(14, 2)
  currency       String   @default("XOF")
  signedDate     DateTime @map("signed_date")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractor   Contractor          @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  site         ConstructionSite    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  costCategory CostCategory        @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)
  statements   ProgressStatement[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([contractorId])
  @@index([siteId])
  @@map("contractor_contracts")
}

/// Une situation d'avancement : ce que le tacheron a execute a une date.
model ProgressStatement {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id")
  contractId        String                @map("contract_id") @db.Uuid
  statementDate     DateTime              @map("statement_date")
  amount            Decimal               @db.Decimal(14, 2)
  currency          String                @default("XOF")
  /// Ce qui a ete fait, en clair. Une situation sans description est un
  /// chiffre que personne ne saura justifier six mois plus tard.
  description       String
  status            SupplierInvoiceStatus @default(DRAFT)
  journalEntryId    String?               @map("journal_entry_id") @db.Uuid
  createdByUserId   String                @map("created_by_user_id")
  validatedByUserId String?               @map("validated_by_user_id")
  validatedAt       DateTime?             @map("validated_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract     ContractorContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?      @relation("ProgressStatementEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("ProgressStatementCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?              @relation("ProgressStatementValidatedBy", fields: [validatedByUserId], references: [id])

  @@index([tenantId])
  @@index([contractId])
  @@map("progress_statements")
}

/// Le reglement d'un tacheron.
///
/// Sans affectation a des situations precises : on regle un tacheron, et le
/// solde de son compte dit ce qui lui reste du. Un reglement verse avant toute
/// situation est un acompte, et il se deduit tout seul.
model ContractorPayment {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id")
  contractorId      String                @map("contractor_id") @db.Uuid
  paymentDate       DateTime              @map("payment_date")
  amount            Decimal               @db.Decimal(14, 2)
  currency          String                @default("XOF")
  status            SupplierInvoiceStatus @default(DRAFT)
  journalEntryId    String?               @map("journal_entry_id") @db.Uuid
  createdByUserId   String                @map("created_by_user_id")
  validatedByUserId String?               @map("validated_by_user_id")
  validatedAt       DateTime?             @map("validated_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractor   Contractor    @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation("ContractorPaymentEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("ContractorPaymentCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy  User?         @relation("ContractorPaymentValidatedBy", fields: [validatedByUserId], references: [id])

  @@index([tenantId])
  @@index([contractorId])
  @@map("contractor_payments")
}

// ===========================================================================
// LOT 4, sous-lot 5 - Retenue de garantie (PRD E6, besoin P15)
// ===========================================================================
//
// On retient une part de ce qu'on doit a un fournisseur ou a un tacheron,
// jusqu'a ce que l'ouvrage ait fait ses preuves. C'est une garantie de bonne
// fin, et l'argent lui revient plus tard.
//
// LA RETENUE NE DIMINUE PAS LA CHARGE, et c'est le piege a ne pas tomber
// dedans. L'ouvrage a coute son prix entier ; ce qui change, c'est ce qu'on
// doit MAINTENANT. L'imputation au cout du chantier reste au montant plein.
// Une retenue qui ferait baisser le cout d'un chantier serait un mensonge
// comptable double d'un mensonge de pilotage : le chantier paraitrait moins
// cher parce qu'on n'a pas fini de payer.
//
// C'EST UN RECLASSEMENT, PAS UNE PIECE DE PLUS DANS LE CYCLE. La piece source
// - facture ou situation - est deja validee et a deja tout constate. La
// retenue deplace une part du solde « du maintenant » vers « detenu » :
//
//   a la retenue    : debit du tiers (401/402), credit des retenues (4047)
//   a la liberation : debit des retenues (4047), credit du tiers
//
// Ce parti pris evite de modifier les validations deja ecrites aux lots 2 et
// 4 - elles n'ont rien a savoir des retenues - au prix d'une fenetre : rien
// n'empeche de regler la piece en entier avant d'avoir pose la retenue. Le
// service la ferme pour les factures (dont les reglements sont affectes) et
// ne le peut pas pour les situations (dont les reglements ne le sont pas).
//
// LE MONTANT EST DERIVE DU TAUX, jamais saisi (principe P-4). Il est stocke
// parce que c'est ce qui a ete effectivement retenu : recalculer plus tard
// avec un taux qui aurait change reecrirait l'histoire.

enum RetentionSourceType {
  SUPPLIER_INVOICE
  PROGRESS_STATEMENT
}

enum RetentionStatus {
  HELD
  RELEASED
}

/// Une retenue de garantie posee sur une piece validee.
model RetentionGuarantee {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @map("tenant_id")
  sourceType             RetentionSourceType @map("source_type")
  sourceId               String              @map("source_id") @db.Uuid
  /// Le tiers dont on retient. Fournisseur ou tacheron : les deux ont un
  /// compte de tiers, et c'est la seule chose qui compte ici.
  thirdPartyAccountId    String              @map("third_party_account_id") @db.Uuid
  /// Chantier concerne. Nul pour une facture qui n'en porte aucun.
  ///
  /// Recopie depuis la piece source plutot que rejoint : une situation tient
  /// son chantier de son marche, une facture du sien, et une lecture « les
  /// retenues de ce chantier » ne doit pas avoir a connaitre les deux chemins.
  siteId                 String?             @map("site_id") @db.Uuid
  /// Le montant de la piece source, au moment ou la retenue est posee.
  baseAmount             Decimal             @map("base_amount") @db.Decimal(14, 2)
  /// Le taux applique, en pourcentage. Parametrable piece par piece.
  ratePercent            Decimal             @map("rate_percent") @db.Decimal(5, 2)
  /// `baseAmount x ratePercent`, arrondi. Derive a la pose, puis fige.
  amount                 Decimal             @db.Decimal(14, 2)
  currency               String              @default("XOF")
  /// Quand on prevoit de la rendre. Une PREVISION : rien ne se libere tout
  /// seul a cette date. La liberation est un acte, et quelqu'un le pose.
  plannedReleaseDate     DateTime            @map("planned_release_date")
  status                 RetentionStatus     @default(HELD)
  heldJournalEntryId     String?             @map("held_journal_entry_id") @db.Uuid
  releasedJournalEntryId String?             @map("released_journal_entry_id") @db.Uuid
  releasedAt             DateTime?           @map("released_at")
  releasedByUserId       String?             @map("released_by_user_id")
  createdByUserId        String              @map("created_by_user_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  thirdPartyAccount ThirdPartyAccount @relation(fields: [thirdPartyAccountId], references: [id], onDelete: Restrict)
  heldEntry         JournalEntry?     @relation("RetentionHeldEntry", fields: [heldJournalEntryId], references: [id], onDelete: SetNull)
  releasedEntry     JournalEntry?     @relation("RetentionReleasedEntry", fields: [releasedJournalEntryId], references: [id], onDelete: SetNull)
  createdBy         User              @relation("RetentionCreatedBy", fields: [createdByUserId], references: [id])
  releasedBy        User?             @relation("RetentionReleasedBy", fields: [releasedByUserId], references: [id])

  /// Une seule retenue par piece. Deux retenues sur la meme facture
  /// retiendraient deux fois, et le fournisseur attendrait longtemps.
  @@unique([sourceType, sourceId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId])
  @@map("retention_guarantees")
}

// ===========================================================================
// LOT 4, sous-lot 6 - Lots, cout de revient et cloture (PRD E6, P16 et P17)
// ===========================================================================
//
// Un chantier produit N lots a vendre ou a louer. Le cout de revient d'un lot
// est sa quote-part du cout total du chantier.
//
// LE COUT PAR LOT NE SE STOCKE PAS. Il se derive du cout du chantier et de la
// cle de repartition, exactement comme le cout reel se derive des imputations
// (principe P-4). Ce qui se fige, c'est le cout du CHANTIER a la cloture, et
// il se fige en etant recopie dans `finalCost`.
//
// POURQUOI FIGER SUFFIT. Un chantier clos n'accepte plus d'imputation : c'est
// la garde qui rend `finalCost` vrai. Sans elle, une facture validee le
// lendemain de la cloture ferait diverger le cout fige du cout reel, et les
// deux chiffres se contrediraient sans que rien ne le signale.
//
// LA CLE DE REPARTITION, trois facons de repartir :
//
//   SURFACE  - au prorata des surfaces. Chaque lot doit avoir la sienne.
//   EQUAL    - parts egales. Aucune donnee supplementaire.
//   MANUAL   - quotes-parts saisies, qui doivent totaliser cent.
//
// Le reliquat d'arrondi va au PREMIER lot, par ordre de creation, sans quoi
// la somme des couts de revient ne vaudrait pas le cout du chantier. Meme
// regle qu'a la ventilation entre associes, et pour la meme raison.
//
// LA BASCULE AU PATRIMOINE cree un bien par lot, avec son cout de revient
// pour valeur d'acquisition - portee par une `AssetValuation`, la ou le
// module patrimoine range deja `acquisitionCost`. Rien de neuf n'est invente
// pour cela.

enum SiteLotAllocationMethod {
  SURFACE
  EQUAL
  MANUAL
}

/// Un lot produit par un chantier.
model SiteLot {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id")
  siteId             String   @map("site_id") @db.Uuid
  name               String
  /// Surface en metres carres. Exigee quand la cle du chantier est SURFACE.
  surfaceArea        Decimal? @map("surface_area") @db.Decimal(12, 2)
  /// Quote-part saisie, en pourcentage. Exigee quand la cle est MANUAL.
  ///
  /// La somme des quotes-parts d'un chantier doit valoir cent, verifiee sur
  /// les valeurs ARRONDIES - celles qui sont stockees. C'est le defaut n°1 du
  /// moteur comptable, et il se rejoue partout ou l'on somme des parts.
  manualSharePercent Decimal? @map("manual_share_percent") @db.Decimal(5, 2)
  /// Le bien cree a la bascule au patrimoine, s'il y en a un.
  ///
  /// Un lot bascule une seule fois : l'unicite l'impose. Sans elle, une
  /// double bascule creerait deux biens pour le meme lot, chacun portant le
  /// cout entier, et le patrimoine compterait deux fois le meme ouvrage.
  propertyId         String?  @unique @map("property_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site     ConstructionSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  property Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Deux lots du meme chantier ne portent pas le meme nom : on ne saurait
  /// plus lequel on regarde.
  @@unique([siteId, name])
  @@index([tenantId])
  @@index([siteId])
  @@map("site_lots")
}

// ===========================================================================
// LOT 5 - Stock de materiaux (PRD E9, besoins S1 a S7)
// ===========================================================================
//
// LE STOCK REDEFINIT LE COUT, IL NE S'Y AJOUTE PAS (principe P-7 du PRD).
// Des que le stock est active sur un chantier, le cout de ses materiaux vient
// des SORTIES de magasin et non des factures. Une facture qui continuerait a
// s'imputer pendant que les sorties s'imputent aussi compterait le ciment
// deux fois, et le chantier paraitrait couter le double de ce qu'il coute.
//
// Le basculement est explicite, par chantier, et IRREVERSIBLE :
// `ConstructionSite.stockEnabledAt` porte la date depuis le lot 2, ou elle
// avait ete posee en prevision et que personne ne lisait. Pas de route pour
// la remettre a nul — revenir en arriere obligerait a rejouer l'imputation
// de toutes les factures posterieures, et le cout du chantier changerait
// sous les pieds de celui qui le regarde.
//
// ---------------------------------------------------------------------------
// La valorisation : cout moyen pondere, et pourquoi le solde se stocke
// ---------------------------------------------------------------------------
//
// Un cout moyen pondere DEPEND DU CHEMIN : il ne se deduit pas de l'ensemble
// des mouvements, il se construit en les rejouant dans l'ordre. C'est la
// seule grandeur de ce module qui echappe a la doctrine « ce qui se calcule
// ne se stocke pas », et elle y echappe pour une raison, pas par facilite.
//
// Le depot suit deja ce schema ailleurs : `ThirdPartyAccount.balance` porte
// le solde, `ThirdPartyMovement.balanceAfter` porte l'etat apres chaque
// mouvement. `StockBalance` et `StockMovement.quantityAfter` reprennent
// exactement ce couple, pour la meme raison et avec la meme discipline.
//
// LE COUT MOYEN EST PAR (ARTICLE, LIEU), pas par article. Le besoin S4 exige
// une quantite ET une valeur par depot et par chantier : un cout moyen global
// ne saurait pas dire ce que vaut le stock d'un depot.
//
// ---------------------------------------------------------------------------
// Un transfert s'ecrit en DEUX mouvements
// ---------------------------------------------------------------------------
//
// Une sortie du lieu d'origine, une entree au lieu d'arrivee, liees par
// `transferGroupId`. Un mouvement unique portant deux lieux obligerait chaque
// calcul de solde a se demander de quel cote il se trouve ; la ou chaque
// mouvement ne touche qu'un lieu, l'arithmetique est la meme partout.
//
// La valeur transferee part au cout moyen du lieu d'origine et recalcule
// celui du lieu d'arrivee. Transferer ne cree ni ne detruit de valeur.

enum StockLocationKind {
  /// Un magasin. Le stock y attend d'etre consomme.
  WAREHOUSE
  /// Le stock pose sur un chantier. Il n'est pas encore consomme pour autant :
  /// c'est la SORTIE qui impute, pas la livraison sur place.
  SITE
}

enum StockMovementType {
  /// Entree, rattachee a une facture fournisseur (besoin S2).
  RECEIPT
  /// Sortie vers un chantier. C'est elle qui impute au cout (besoin S3).
  ISSUE
  /// Deplacement entre deux lieux. S'ecrit en deux mouvements.
  TRANSFER
  /// Ecart d'inventaire : casse, perte, vol (besoin S6).
  ADJUSTMENT
}

enum StockValuationMethod {
  /// Cout moyen pondere. La seule methode offerte aujourd'hui, et le defaut
  /// que le PRD retient (besoin S5).
  ///
  /// L'enumeration n'a qu'une valeur, et c'est volontaire : elle existe pour
  /// que le CHOIX soit enregistre et date, pas pour laisser croire qu'un
  /// autre choix est disponible. En ajouter un (PEPS, cout standard) est un
  /// travail a part entiere, pas une ligne de configuration.
  WEIGHTED_AVERAGE
}

enum StockCountStatus {
  DRAFT
  VALIDATED
}

/// La methode de valorisation de l'agence, figee et datee (besoin S5).
///
/// Une table a part plutot qu'une colonne sur `Tenant` : `Tenant` est partage
/// par tous les modules du produit, et un reglage propre a la finance des
/// chantiers n'a rien a y faire.
model StockSettings {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @unique @map("tenant_id")
  valuationMethod StockValuationMethod @default(WEIGHTED_AVERAGE) @map("valuation_method")
  /// Quand la methode a ete arretee. Le PRD veut qu'un changement soit une
  /// decision documentee ; sans date ni motif, ce n'en serait pas une.
  decidedAt       DateTime             @default(now()) @map("decided_at")
  /// Pourquoi cette methode. Libre, et exige a chaque changement.
  decisionNote    String?              @map("decision_note")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("stock_settings")
}

/// Un article du referentiel (besoin S1).
model StockItem {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id")
  /// Reference interne, unique dans l'agence. C'est ce qu'on lit sur un bon.
  reference             String
  label                 String
  /// Sac, tonne, barre, metre cube. Texte libre : les unites d'une agence
  /// ivoirienne ne sont pas celles d'une autre, et une enumeration figee
  /// obligerait a livrer une version pour ajouter « fut ».
  unit                  String
  /// Famille d'articles, en clair : « Ciment », « Fer a beton ». Libre.
  category              String?
  /// Poste de depense PROPOSE a la sortie. Une proposition, jamais une
  /// autorite : la sortie exige son poste, et l'ecran le presente
  /// pre-selectionne. Meme parti pris qu'au poste « main-d'oeuvre » des
  /// salaires, et pour la meme raison — un poste devine se lirait comme un
  /// choix sans en etre un.
  defaultCostCategoryId String?  @map("default_cost_category_id") @db.Uuid
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultCostCategory CostCategory?    @relation(fields: [defaultCostCategoryId], references: [id], onDelete: SetNull)
  balances            StockBalance[]
  movements           StockMovement[]
  countLines          StockCountLine[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("stock_items")
}

/// Un lieu de stockage : un magasin, ou un chantier (besoin S4).
model StockLocation {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id")
  kind      StockLocationKind
  label     String
  /// Le chantier, quand `kind` vaut SITE. Nul pour un magasin.
  ///
  /// UN SEUL LIEU PAR CHANTIER : l'unicite l'impose. Deux lieux pour le meme
  /// chantier partageraient son stock en deux soldes dont aucun ne dirait la
  /// verite.
  siteId    String?           @unique @map("site_id") @db.Uuid
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      ConstructionSite? @relation(fields: [siteId], references: [id], onDelete: Restrict)
  balances  StockBalance[]
  movements StockMovement[]
  counts    StockCount[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("stock_locations")
}

/// Ce qu'il reste d'un article dans un lieu, et ce que ca vaut.
///
/// Stocke, contrairement a tout le reste du module — voir l'en-tete : un cout
/// moyen pondere depend du chemin et ne se deduit pas d'un ensemble de
/// mouvements. Meme couple que `ThirdPartyAccount.balance` /
/// `ThirdPartyMovement.balanceAfter`, deja en place depuis le lot 1.
model StockBalance {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id")
  itemId     String   @map("item_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// Quantite en stock. Quatre decimales : on compte des tonnes et des
  /// metres cubes, pas seulement des sacs entiers.
  quantity   Decimal  @default(0) @db.Decimal(16, 4)
  /// Valeur du stock. Le cout moyen unitaire s'en deduit : `value / quantity`
  /// quand la quantite n'est pas nulle. Il ne se stocke PAS — ce serait une
  /// troisieme grandeur a tenir d'accord avec les deux autres.
  value      Decimal  @default(0) @db.Decimal(16, 2)
  currency   String   @default("XOF")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     StockItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([itemId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("stock_balances")
}

/// Un mouvement de stock. Table unique, typee.
///
/// Chaque mouvement ne touche QU'UN lieu. Un transfert s'ecrit donc en deux
/// lignes liees par `transferGroupId` — voir l'en-tete.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id")
  type         StockMovementType
  itemId       String            @map("item_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  movementDate DateTime          @map("movement_date")

  /// Toujours POSITIVE. C'est `type` qui dit le sens, jamais le signe : une
  /// quantite negative sur une reception serait indechiffrable six mois plus
  /// tard, et rien n'empecherait d'en saisir une par erreur.
  ///
  /// Un ajustement d'inventaire negatif s'ecrit donc avec `isDecrease`.
  quantity   Decimal @db.Decimal(16, 4)
  /// Vrai quand le mouvement diminue le stock du lieu. Redondant avec `type`
  /// pour RECEIPT et ISSUE, indispensable pour ADJUSTMENT, qui va dans les
  /// deux sens.
  isDecrease Boolean @default(false) @map("is_decrease")

  /// Prix unitaire de l'entree, pour une reception. Pour une sortie ou un
  /// transfert, c'est le cout moyen du lieu au moment du mouvement — calcule,
  /// jamais saisi (principe P-4).
  unitCost   Decimal @map("unit_cost") @db.Decimal(16, 4)
  /// `quantity x unitCost`, arrondi. La valeur qui bouge.
  totalValue Decimal @map("total_value") @db.Decimal(16, 2)
  currency   String  @default("XOF")

  /// L'etat du lieu APRES ce mouvement. Piste d'audit, jamais relue pour
  /// calculer : c'est `StockBalance` qui fait autorite.
  quantityAfter Decimal @map("quantity_after") @db.Decimal(16, 4)
  valueAfter    Decimal @map("value_after") @db.Decimal(16, 2)

  /// Le chantier impute, pour une SORTIE. C'est ce qui fait entrer le
  /// materiau dans le cout (besoin S3).
  siteId         String? @map("site_id") @db.Uuid
  /// Le poste de la sortie. Exige des qu'il y a un chantier : une imputation
  /// sans poste n'existe pas.
  costCategoryId String? @map("cost_category_id") @db.Uuid
  /// Qui a demande la sortie, en clair. Le PRD l'exige (besoin S3).
  requestedBy    String? @map("requested_by")

  /// La facture qui a valorise la reception (besoin S2).
  supplierInvoiceId String? @map("supplier_invoice_id") @db.Uuid
  /// Les deux moities d'un transfert portent le meme identifiant.
  transferGroupId   String? @map("transfer_group_id") @db.Uuid
  /// L'inventaire dont cet ajustement decoule.
  stockCountId      String? @map("stock_count_id") @db.Uuid
  /// Pourquoi, pour un ajustement : casse, perte, vol. Exige.
  reason            String?

  journalEntryId  String?  @map("journal_entry_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            StockItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location        StockLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  site            ConstructionSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  costCategory    CostCategory?     @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)
  supplierInvoice SupplierInvoice?  @relation("StockReceiptInvoice", fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  stockCount      StockCount?       @relation(fields: [stockCountId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?     @relation("StockMovementEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User              @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@index([itemId, locationId, createdAt])
  @@index([siteId])
  @@index([transferGroupId])
  @@map("stock_movements")
}

/// Un inventaire physique (besoin S6).
model StockCount {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id")
  locationId        String           @map("location_id") @db.Uuid
  countedAt         DateTime         @map("counted_at")
  status            StockCountStatus @default(DRAFT)
  createdByUserId   String           @map("created_by_user_id")
  validatedByUserId String?          @map("validated_by_user_id")
  validatedAt       DateTime?        @map("validated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("StockCountCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy User?            @relation("StockCountValidatedBy", fields: [validatedByUserId], references: [id])
  lines       StockCountLine[]
  adjustments StockMovement[]

  @@index([tenantId])
  @@index([locationId])
  @@map("stock_counts")
}

/// Une ligne de comptage : ce qu'on a trouve, face a ce que le systeme disait.
model StockCountLine {
  id               String  @id @default(uuid()) @db.Uuid
  countId          String  @map("count_id") @db.Uuid
  itemId           String  @map("item_id") @db.Uuid
  /// Ce que le systeme disait au moment du comptage. FIGE a la saisie.
  ///
  /// Recopie, et c'est voulu : relire le solde a la validation comparerait le
  /// comptage d'hier au stock d'aujourd'hui, et l'ecart ne voudrait plus rien
  /// dire.
  expectedQuantity Decimal @map("expected_quantity") @db.Decimal(16, 4)
  /// Ce qu'on a compte.
  countedQuantity  Decimal @map("counted_quantity") @db.Decimal(16, 4)
  /// Pourquoi l'ecart. Exige des qu'il y en a un : un ecart sans motif est
  /// une perte que personne n'expliquera.
  reason           String?

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  StockItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([countId, itemId])
  @@index([countId])
  @@map("stock_count_lines")
}

// =============================================================
// GESTION LOCATIVE — Lot 3, compte proprietaire et reversements
// =============================================================

enum OwnerPayoutStatus {
  VALIDATED
  VOIDED
}

/// Reversement fait par l'agence a un proprietaire.
///
/// Valide des son enregistrement et numerote `REV-AAAA-NNNN` : c'est une
/// sortie d'argent reelle, elle ne passe pas par un brouillon. Elle ne se
/// modifie pas et ne se supprime pas ; une erreur s'annule, avec un motif, par
/// une contre-passation qui reste visible dans le compte et au grand livre.
model OwnerPayout {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id")
  ownerClientId     String            @map("owner_client_id")
  accountId         String            @map("account_id") @db.Uuid
  year              Int
  sequence          Int
  amount            Decimal           @db.Decimal(14, 2)
  paidAt            DateTime          @map("paid_at")
  method            PaymentMethod
  /// Lot 10 : compte de tresorerie debite. Nul : celui par defaut du moyen.
  treasuryAccountId String?           @map("treasury_account_id") @db.Uuid
  reference         String?
  notes             String?
  /// Releve de gerance regle par ce reversement, s'il y en a un.
  statementId       String?           @map("statement_id") @db.Uuid
  status            OwnerPayoutStatus @default(VALIDATED)
  voidReason        String?           @map("void_reason")
  voidedAt          DateTime?         @map("voided_at")
  voidedByUserId    String?           @map("voided_by_user_id")
  createdByUserId   String?           @map("created_by_user_id")
  createdAt         DateTime          @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerClient TenantClient @relation(fields: [ownerClientId], references: [id], onDelete: Restrict)

  @@unique([tenantId, year, sequence])
  @@index([tenantId, ownerClientId])
  @@map("owner_payouts")
}

// =============================================================
// GESTION LOCATIVE — Lot 5, vie du bail et etats des lieux
// =============================================================

enum LeaseEventType {
  REVISION
  RENEWAL
  AMENDMENT
  TERMINATION
}

enum LeaseTerminationInitiator {
  TENANT
  LANDLORD
  MUTUAL
}

/// Historique d'un bail : revisions de loyer, renouvellements, avenants,
/// resiliation.
///
/// Un evenement ne se modifie pas et ne se supprime pas : il raconte ce qui a
/// ete decide, a quelle date, et ce que le bail etait avant. Les colonnes
/// `previous*` gardent l'etat anterieur, pour qu'on puisse relire l'histoire
/// d'un loyer sans la reconstituer.
model LeaseEvent {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id")
  leaseId         String                     @map("lease_id") @db.Uuid
  type            LeaseEventType
  effectiveDate   DateTime                   @map("effective_date")
  // Revision (et renouvellement avec nouveau loyer)
  previousRent    Decimal?                   @map("previous_rent") @db.Decimal(12, 2)
  newRent         Decimal?                   @map("new_rent") @db.Decimal(12, 2)
  previousCharges Decimal?                   @map("previous_charges") @db.Decimal(12, 2)
  newCharges      Decimal?                   @map("new_charges") @db.Decimal(12, 2)
  /// Taux de revision annonce, en pourcentage ; informatif.
  revisionRate    Decimal?                   @map("revision_rate") @db.Decimal(6, 3)
  // Renouvellement et resiliation
  previousEndDate DateTime?                  @map("previous_end_date")
  newEndDate      DateTime?                  @map("new_end_date")
  // Resiliation
  noticeDate      DateTime?                  @map("notice_date")
  initiatedBy     LeaseTerminationInitiator? @map("initiated_by")
  moveOutDate     DateTime?                  @map("move_out_date")
  /// Motif, objet de l'avenant, observations.
  summary         String?                    @db.Text
  /// Effets constates : echeances recalculees, creees ou annulees.
  details         Json?
  createdByUserId String?                    @map("created_by_user_id")
  createdAt       DateTime                   @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease  RentalLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leaseId, effectiveDate])
  @@map("lease_events")
}

enum LeaseInspectionType {
  ENTRY
  EXIT
}

enum LeaseInspectionStatus {
  DRAFT
  FINALIZED
}

/// Etat des lieux d'entree ou de sortie.
///
/// Brouillon tant qu'on le remplit ; fige une fois finalise, parce qu'il fait
/// foi entre le bailleur et le locataire. Un par type et par bail.
///
/// `rooms` : `[{ id, name, items: [{ id, label, condition, comment }] }]`,
/// `condition` parmi NEW, GOOD, FAIR, POOR, BROKEN. Les identifiants de piece
/// et d'element sont stables : la comparaison entree/sortie et les photos s'y
/// accrochent. `deductions` (sortie seulement) :
/// `[{ id, label, amount, roomId?, itemId? }]`, les retenues proposees sur le
/// depot de garantie.
model LeaseInspection {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id")
  leaseId             String                @map("lease_id") @db.Uuid
  type                LeaseInspectionType
  status              LeaseInspectionStatus @default(DRAFT)
  inspectionDate      DateTime              @map("inspection_date")
  rooms               Json                  @default("[]")
  /// Index des compteurs : `{ electricity?, water?, gas? }`, en texte.
  meters              Json?
  keysCount           Int?                  @map("keys_count")
  generalComment      String?               @map("general_comment") @db.Text
  tenantPresent       Boolean               @default(true) @map("tenant_present")
  tenantSignatoryName String?               @map("tenant_signatory_name")
  agentSignatoryName  String?               @map("agent_signatory_name")
  deductions          Json?
  finalizedAt         DateTime?             @map("finalized_at")
  finalizedByUserId   String?               @map("finalized_by_user_id")
  createdByUserId     String?               @map("created_by_user_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease  RentalLease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  photos LeaseInspectionPhoto[]

  @@unique([leaseId, type])
  @@index([tenantId])
  @@map("lease_inspections")
}

/// Photo d'un etat des lieux, rattachee a une piece ou a un element.
/// Fichier prive : jamais servi en statique, toujours par une route qui
/// verifie l'agence.
model LeaseInspectionPhoto {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id")
  inspectionId     String   @map("inspection_id") @db.Uuid
  roomId           String?  @map("room_id")
  itemId           String?  @map("item_id")
  fileName         String   @map("file_name")
  filePath         String   @map("file_path")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  caption          String?
  uploadedByUserId String?  @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inspection LeaseInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inspectionId])
  @@map("lease_inspection_photos")
}

// =============================================================
// GESTION LOCATIVE — Lot 4, indivision
// =============================================================

/// Quote-part d'un indivisaire dans un bien.
///
/// Un bien sans quote-part appartient en entier au proprietaire designe sur
/// ses baux, comme avant ce lot. Un bien qui en a est reparti entre ses
/// indivisaires, et les parts somment a 100 : loyers encaisses, honoraires,
/// TVA et depenses du bien se partagent au prorata dans les comptes des
/// proprietaires et sur leurs releves.
model PropertyOwnershipShare {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id")
  propertyId      String   @map("property_id")
  ownerClientId   String   @map("owner_client_id")
  /// En pourcentage : 50 pour 50 %. Quatre decimales pour les tiers.
  sharePercent    Decimal  @map("share_percent") @db.Decimal(7, 4)
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerClient TenantClient @relation(fields: [ownerClientId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerClientId])
  @@index([tenantId])
  @@index([ownerClientId])
  @@map("property_ownership_shares")
}

// =============================================================
// GESTION LOCATIVE — Lot 6, caisse d'agence
// =============================================================

enum CashSessionStatus {
  OPEN
  CLOSED
  VALIDATED
}

/// Session de caisse d'un caissier : ouverte avec un fond de caisse, close
/// par un comptage, validee par un responsable.
///
/// Le montant ATTENDU n'est jamais saisi : il se deduit des encaissements et
/// decaissements en especes enregistres par le caissier pendant la session
/// (`lib/cash-sessions`). Il est fige a la cloture, avec son detail, pour que
/// la session relue plus tard dise ce qu'on attendait ce jour-la.
///
/// Un ecart non nul exige un motif. A la validation, il passe en comptabilite :
/// un manquant en charge, un excedent en produit.
model CashSession {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id")
  year              Int
  sequence          Int
  cashierUserId     String            @map("cashier_user_id")
  /// Lot 10 : la caisse physique tenue. Nulle : caisse par defaut.
  treasuryAccountId String?           @map("treasury_account_id") @db.Uuid
  status            CashSessionStatus @default(OPEN)
  openedAt          DateTime          @default(now()) @map("opened_at")
  openingFloat      Decimal           @map("opening_float") @db.Decimal(14, 2)
  openingNote       String?           @map("opening_note")
  closedAt          DateTime?         @map("closed_at")
  /// Detail fige a la cloture : `{ receipts, disbursements, lines: [...] }`.
  expectedBreakdown Json?             @map("expected_breakdown")
  expectedAmount    Decimal?          @map("expected_amount") @db.Decimal(14, 2)
  countedAmount     Decimal?          @map("counted_amount") @db.Decimal(14, 2)
  /// Billetage : `{ "10000": 3, "5000": 2, ... }`, nombre de billets et pieces.
  denominations     Json?
  difference        Decimal?          @db.Decimal(14, 2)
  differenceReason  String?           @map("difference_reason")
  validatedAt       DateTime?         @map("validated_at")
  validatedByUserId String?           @map("validated_by_user_id")
  validationComment String?           @map("validation_comment")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, sequence])
  @@index([tenantId, cashierUserId, status])
  @@map("cash_sessions")
}

// =============================================================
// GESTION LOCATIVE — Lot 10, conformite SYSCOHADA
// =============================================================

/// Nature des fonds d'un mandant portes par une ligne du compte 4731.
enum MandantFundsNature {
  /// Compte courant : ce qui sera reverse au proprietaire.
  CURRENT
  /// Depot de garantie detenu pour le compte du proprietaire.
  DEPOSIT
  /// Encaissement recu, pas encore affecte a une echeance.
  UNALLOCATED
}

enum PenaltyBeneficiary {
  OWNER
  AGENCY
}

enum OwnerTaxStatus {
  INDIVIDUAL
  COMPANY
  EXEMPT
}

enum TreasuryAccountKind {
  CASH
  BANK
  MOBILE_MONEY
  CHECKS_TO_CASH
  CARDS_TO_CASH
}

enum TreasuryDocumentStatus {
  VALIDATED
  VOIDED
}

/// Compte de tresorerie de l'agence : une caisse (5711x), une banque (5211x),
/// un portefeuille Mobile Money (552x), les cheques (513) ou cartes (515) a
/// encaisser. Chaque encaissement et decaissement dit lequel il a touche.
///
/// Un seul compte par defaut par nature (et par operateur pour le Mobile
/// Money) : c'est celui qu'on prend quand la piece n'en precise pas.
model TreasuryAccount {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id")
  kind             TreasuryAccountKind
  label            String
  chartOfAccountId String               @unique @map("chart_of_account_id") @db.Uuid
  accountNumber    String               @map("account_number")
  mmOperator       MobileMoneyOperator? @map("mm_operator")
  bankName         String?              @map("bank_name")
  bankAccountRef   String?              @map("bank_account_ref")
  isDefault        Boolean              @default(false) @map("is_default")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, accountNumber])
  @@index([tenantId, kind])
  @@map("treasury_accounts")
}

/// Virement interne entre deux comptes de tresorerie : remise de cheques ou
/// de cartes en banque, depot d'especes, approvisionnement d'une caisse.
/// Numerote VIR-AAAA-NNNN.
model TreasuryTransfer {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id")
  year                  Int
  sequence              Int
  fromTreasuryAccountId String                 @map("from_treasury_account_id") @db.Uuid
  toTreasuryAccountId   String                 @map("to_treasury_account_id") @db.Uuid
  amount                Decimal                @db.Decimal(14, 2)
  transferredAt         DateTime               @map("transferred_at")
  reference             String?
  notes                 String?
  status                TreasuryDocumentStatus @default(VALIDATED)
  voidReason            String?                @map("void_reason")
  voidedAt              DateTime?              @map("voided_at")
  voidedByUserId        String?                @map("voided_by_user_id")
  createdByUserId       String?                @map("created_by_user_id")
  createdAt             DateTime               @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, sequence])
  @@index([tenantId, transferredAt])
  @@map("treasury_transfers")
}

/// Retenue a la source sur un loyer encaisse, pour UN proprietaire.
///
/// Figee a sa creation comme les honoraires : statut fiscal, taux et assiette
/// du jour. Une par (affectation, proprietaire), parce qu'en indivision chaque
/// indivisaire a son propre statut.
model RentWithholding {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id")
  allocationId  String         @map("allocation_id") @db.Uuid
  ownerClientId String         @map("owner_client_id")
  leaseId       String         @map("lease_id") @db.Uuid
  propertyId    String         @map("property_id")
  collectedAt   DateTime       @map("collected_at")
  taxStatus     OwnerTaxStatus @map("tax_status")
  baseAmount    Decimal        @map("base_amount") @db.Decimal(14, 2)
  rate          Decimal        @db.Decimal(5, 2)
  amount        Decimal        @db.Decimal(14, 2)
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([allocationId, ownerClientId])
  @@index([tenantId, ownerClientId, collectedAt])
  @@map("rent_withholdings")
}

/// Versement a la DGI des retenues collectees : debit 4478, credit tresorerie.
/// Numerote DGI-AAAA-NNNN.
model TaxRemittance {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id")
  year              Int
  sequence          Int
  amount            Decimal                @db.Decimal(14, 2)
  paidAt            DateTime               @map("paid_at")
  periodLabel       String                 @map("period_label")
  treasuryAccountId String                 @map("treasury_account_id") @db.Uuid
  reference         String?
  status            TreasuryDocumentStatus @default(VALIDATED)
  voidReason        String?                @map("void_reason")
  voidedAt          DateTime?              @map("voided_at")
  voidedByUserId    String?                @map("voided_by_user_id")
  createdByUserId   String?                @map("created_by_user_id")
  createdAt         DateTime               @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, sequence])
  @@map("tax_remittances")
}

// =============================================================
// VENTES IMMOBILIERES — Lot 9
// =============================================================
//
// Chaine complete d'une vente ou l'agence est intermediaire : mandat de vente,
// offres d'achat, compromis, acte authentique, commission de transaction.
// Voir docs/ventes/PRD-lot-9-ventes.md, section 3, qui fait foi.
//
// P3 : l'agence ne detient aucun fonds de la vente. Seule la commission entre
// en comptabilite (P4 : nee a l'acte ; P5 : comptabilisee a l'encaissement,
// comme la gestion locative du lot 10).
//
// Numerotation annuelle par agence (colonnes year + sequence, comme
// `TreasuryTransfer` et `TaxRemittance` du lot 10) : MV, OA, CV, HT, RC.

enum SaleMandateType {
  SIMPLE
  EXCLUSIVE
}

enum SaleMandateStatus {
  ACTIVE
  REVOKED
  COMPLETED
}

enum SaleCommissionMode {
  PERCENT
  FIXED
}

enum SaleCommissionPayer {
  SELLER
  BUYER
}

enum SaleFinancing {
  CASH
  LOAN
  MIXED
}

enum SaleOfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SaleDepositHolder {
  NOTARY
  SELLER
}

enum SaleAgreementStatus {
  DRAFT
  SIGNED
  COMPLETED
  CANCELLED
}

enum SaleConditionStatus {
  PENDING
  MET
  FAILED
  WAIVED
}

enum SaleCommissionStatus {
  DUE
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SaleCommissionPaymentStatus {
  POSTED
  VOIDED
}

/// Mandat de vente d'un bien : vendeur (`TenantClient`, decision du 22/09),
/// prix demande et honoraires convenus. Numerote MV-AAAA-NNNN.
///
/// UN SEUL MANDAT ACTIVE PAR BIEN ET PAR AGENCE : controle applicatif (le
/// service verifie avant de creer), pas de contrainte SQL — un index simple
/// suffit a la lecture, une contrainte d'unicite partielle sur (propertyId)
/// filtree par statut n'a pas de syntaxe Prisma native et aurait exige du SQL
/// brut dans la migration pour un gain modeste face au controle applicatif
/// deja necessaire pour le message d'erreur en francais.
model SaleMandate {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id")
  year                  Int
  sequence              Int
  propertyId            String              @map("property_id")
  sellerClientId        String              @map("seller_client_id")
  mandateType           SaleMandateType     @map("mandate_type")
  askingPrice           Decimal             @map("asking_price") @db.Decimal(14, 2)
  /// Prix plancher confidentiel : jamais restitue a l'acquereur.
  minimumPrice          Decimal?            @map("minimum_price") @db.Decimal(14, 2)
  commissionMode        SaleCommissionMode  @map("commission_mode")
  commissionRate        Decimal?            @map("commission_rate") @db.Decimal(7, 4)
  commissionFixedAmount Decimal?            @map("commission_fixed_amount") @db.Decimal(14, 2)
  commissionPayer       SaleCommissionPayer @map("commission_payer")
  agentUserId           String?             @map("agent_user_id")
  /// Part du negociateur sur la commission HT encaissee, en pourcentage.
  agentSharePercent     Decimal?            @map("agent_share_percent") @db.Decimal(7, 4)
  startDate             DateTime            @map("start_date") @db.Date
  endDate               DateTime?           @map("end_date") @db.Date
  status                SaleMandateStatus   @default(ACTIVE)
  revokedAt             DateTime?           @map("revoked_at")
  revokedByUserId       String?             @map("revoked_by_user_id")
  revokeReason          String?             @map("revoke_reason") @db.Text
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sellerClient TenantClient     @relation(fields: [sellerClientId], references: [id], onDelete: Restrict)
  agentUser    User?            @relation("SaleMandateAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  revokedBy    User?            @relation("SaleMandateRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  offers       SaleOffer[]
  agreements   SaleAgreement[]
  commissions  SaleCommission[]

  @@unique([tenantId, year, sequence])
  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  @@index([sellerClientId])
  @@index([agentUserId])
  @@map("sale_mandates")
}

/// Offre d'achat sur un mandat, portee par un acquereur (`CrmContact`, P2).
/// Numerotee OA-AAAA-NNNN.
model SaleOffer {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id")
  year            Int
  sequence        Int
  mandateId       String          @map("mandate_id") @db.Uuid
  buyerContactId  String          @map("buyer_contact_id")
  /// Affaire CRM d'origine, si l'offre en vient.
  dealId          String?         @map("deal_id")
  amount          Decimal         @db.Decimal(14, 2)
  financing       SaleFinancing
  conditions      String?         @db.Text
  validUntil      DateTime?       @map("valid_until") @db.Date
  status          SaleOfferStatus @default(SUBMITTED)
  /// Contre-offre du vendeur, posee par l'action COUNTER.
  counterAmount   Decimal?        @map("counter_amount") @db.Decimal(14, 2)
  decidedAt       DateTime?       @map("decided_at")
  decidedByUserId String?         @map("decided_by_user_id")
  decisionReason  String?         @map("decision_reason") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mandate      SaleMandate    @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  buyerContact CrmContact     @relation(fields: [buyerContactId], references: [id], onDelete: Restrict)
  deal         CrmDeal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  decidedBy    User?          @relation("SaleOfferDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  agreement    SaleAgreement?

  @@unique([tenantId, year, sequence])
  @@index([tenantId, status])
  @@index([mandateId])
  @@index([buyerContactId])
  @@index([dealId])
  @@map("sale_offers")
}

/// Compromis de vente ne d'une offre ACCEPTED. Numerote CV-AAAA-NNNN.
/// Un seul compromis par offre : `@unique` sur `offerId` (PRD §3).
model SaleAgreement {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id")
  year              Int
  sequence          Int
  offerId           String              @unique @map("offer_id") @db.Uuid
  /// Recopies de l'offre/du mandat pour les requetes, jamais divergents en
  /// dehors de la creation.
  mandateId         String              @map("mandate_id") @db.Uuid
  propertyId        String              @map("property_id")
  price             Decimal             @db.Decimal(14, 2)
  depositAmount     Decimal?            @map("deposit_amount") @db.Decimal(14, 2)
  depositHolder     SaleDepositHolder?  @map("deposit_holder")
  notaryName        String?             @map("notary_name")
  signedAt          DateTime?           @map("signed_at") @db.Date
  expectedDeedDate  DateTime?           @map("expected_deed_date") @db.Date
  deedDate          DateTime?           @map("deed_date") @db.Date
  status            SaleAgreementStatus @default(DRAFT)
  cancelledAt       DateTime?           @map("cancelled_at")
  cancelReason      String?             @map("cancel_reason") @db.Text
  cancelledByUserId String?             @map("cancelled_by_user_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer       SaleOffer                @relation(fields: [offerId], references: [id], onDelete: Restrict)
  mandate     SaleMandate              @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  property    Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  cancelledBy User?                    @relation("SaleAgreementCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  conditions  SaleAgreementCondition[]
  milestones  SalePaymentMilestone[]
  commission  SaleCommission?

  @@unique([tenantId, year, sequence])
  @@index([tenantId, status])
  @@index([mandateId])
  @@index([propertyId])
  @@map("sale_agreements")
}

/// Condition suspensive d'un compromis. Une condition FAILED n'annule pas
/// seule le compromis : l'agent decide (PRD §3).
model SaleAgreementCondition {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id")
  agreementId String              @map("agreement_id") @db.Uuid
  label       String
  dueDate     DateTime?           @map("due_date") @db.Date
  status      SaleConditionStatus @default(PENDING)
  resolvedAt  DateTime?           @map("resolved_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreement SaleAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agreementId])
  @@map("sale_agreement_conditions")
}

/// Echeancier de paiement de l'acquereur : suivi, sans ecriture comptable
/// (P3 — l'agence ne detient pas ces fonds).
model SalePaymentMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id")
  agreementId String    @map("agreement_id") @db.Uuid
  label       String
  dueDate     DateTime? @map("due_date") @db.Date
  amount      Decimal   @db.Decimal(14, 2)
  paidAt      DateTime? @map("paid_at") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreement SaleAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agreementId])
  @@map("sale_payment_milestones")
}

/// Commission de transaction, creee automatiquement au passage du compromis
/// a COMPLETED (P4). Figee a sa creation : taux de TVA et part du negociateur
/// ne suivent plus les parametres ou le mandat apres coup. Numerotee
/// HT-AAAA-NNNN. `paidAmount` et `status` sont calcules a la lecture depuis
/// les reglements POSTED — jamais stockes, pour ne jamais diverger d'eux.
model SaleCommission {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id")
  year              Int
  sequence          Int
  agreementId       String               @unique @map("agreement_id") @db.Uuid
  mandateId         String               @map("mandate_id") @db.Uuid
  /// Recopie du mandat.
  payer             SaleCommissionPayer
  /// Prix de vente du compromis complete.
  baseAmount        Decimal              @map("base_amount") @db.Decimal(14, 2)
  amountExclTax     Decimal              @map("amount_excl_tax") @db.Decimal(14, 2)
  /// Taux des parametres financiers si l'agence est assujettie, sinon 0 —
  /// fige au moment de la creation (P5).
  vatRate           Decimal              @map("vat_rate") @db.Decimal(5, 2)
  vatAmount         Decimal              @map("vat_amount") @db.Decimal(14, 2)
  amountInclTax     Decimal              @map("amount_incl_tax") @db.Decimal(14, 2)
  /// Recopies (figees) du mandat.
  agentUserId       String?              @map("agent_user_id")
  agentSharePercent Decimal?             @map("agent_share_percent") @db.Decimal(7, 4)
  status            SaleCommissionStatus @default(DUE)
  /// = deedDate du compromis.
  issuedAt          DateTime             @map("issued_at") @db.Date
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreement SaleAgreement           @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  mandate   SaleMandate             @relation(fields: [mandateId], references: [id], onDelete: Restrict)
  agentUser User?                   @relation("SaleCommissionAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  payments  SaleCommissionPayment[]

  @@unique([tenantId, year, sequence])
  @@index([tenantId, status])
  @@index([mandateId])
  @@map("sale_commissions")
}

/// Reglement (encaissement) d'une commission de vente. Numerote RC-AAAA-NNNN.
/// `treasuryAccountId` designe librement un `TreasuryAccount` (pas de
/// relation Prisma), comme `TaxRemittance.treasuryAccountId` au lot 10 : le
/// compte est verifie par `assertTreasuryAccountUsableTx` au moment d'ecrire,
/// pas par une contrainte de cle etrangere supplementaire.
model SaleCommissionPayment {
  id                String                      @id @default(uuid()) @db.Uuid
  tenantId          String                      @map("tenant_id")
  year              Int
  sequence          Int
  commissionId      String                      @map("commission_id") @db.Uuid
  amount            Decimal                     @db.Decimal(14, 2)
  paidAt            DateTime                    @map("paid_at")
  paymentMethod     RentalPaymentMethod         @map("payment_method")
  treasuryAccountId String                      @map("treasury_account_id") @db.Uuid
  reference         String?
  status            SaleCommissionPaymentStatus @default(POSTED)
  voidReason        String?                     @map("void_reason")
  voidedAt          DateTime?                   @map("voided_at")
  voidedByUserId    String?                     @map("voided_by_user_id")
  createdByUserId   String?                     @map("created_by_user_id")
  createdAt         DateTime                    @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commission SaleCommission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  voidedBy   User?          @relation("SaleCommissionPaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("SaleCommissionPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, year, sequence])
  @@index([tenantId, status])
  @@index([commissionId])
  @@map("sale_commission_payments")
}

// =============================================================
// PAIEMENT DE L'ABONNEMENT (vague 3, lot B — PLAN-ABONNEMENTS.md)
// Migration 20260928120000_abonnements_paiement. Aucune relation Prisma
// formelle (comme AuditLog) : ces tables ne touchent ni Tenant ni Invoice,
// que d'autres lots modifient.
// =============================================================

/// Mode de reglement d'une facture PLATFORM.
enum PlatformPaymentMethod {
  ONLINE // PaySecureHub, compte ImmoTopia
  BANK_TRANSFER
  MOBILE_MONEY
  CHECK
  CASH
}

/// Reglement d'une facture PLATFORM : un seul par facture (index unique).
/// Ecrit par le rapprochement en ligne ou par le constat du super-admin ;
/// jamais supprime ni defait par un statut ulterieur de l'agregateur.
model PlatformInvoicePayment {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id")
  invoiceId        String                @unique @map("invoice_id")
  method           PlatformPaymentMethod
  amount           Decimal               @db.Decimal(14, 2)
  currency         String                @default("FCFA")
  paidAt           DateTime              @map("paid_at")
  reference        String?
  note             String?               @db.Text
  /// Justificatif prive : chemin relatif a la racine des depots, jamais servi en statique.
  proofPath        String?               @map("proof_path")
  proofName        String?               @map("proof_name")
  proofMimeType    String?               @map("proof_mime_type")
  checkoutId       String?               @map("checkout_id") @db.Uuid
  recordedByUserId String?               @map("recorded_by_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("platform_invoice_payments")
}

/// Tentative de paiement en ligne d'une facture PLATFORM sur le compte
/// PaySecureHub d'ImmoTopia (distinct des comptes des agences, lot 7).
/// Code "IMP-" + 20 caracteres : discrimine l'IPN des loyers ("IMT-").
model PlatformPaymentCheckout {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id")
  invoiceId             String                 @map("invoice_id")
  provider              PaymentGatewayProvider @default(PAYSECUREHUB)
  mode                  PaymentGatewayMode
  codePaiement          String                 @unique @map("code_paiement")
  amount                Decimal                @db.Decimal(14, 2)
  currency              String                 @default("FCFA")
  checkoutUrl           String?                @map("checkout_url")
  providerToken         String?                @map("provider_token")
  providerTransactionId String?                @map("provider_transaction_id")
  providerServiceName   String?                @map("provider_service_name")
  providerFees          Decimal?               @map("provider_fees") @db.Decimal(12, 2)
  status                OnlineCheckoutStatus   @default(PENDING)
  lastProviderState     String?                @map("last_provider_state")
  lastProviderPayload   Json?                  @map("last_provider_payload")
  lastCheckedAt         DateTime?              @map("last_checked_at")
  checkAttempts         Int                    @default(0) @map("check_attempts")
  failureMessage        String?                @map("failure_message")
  reviewReason          String?                @map("review_reason")
  /// SUCCESS | FAILED | CANCELED — mode simulateur seulement.
  simulatedOutcome      String?                @map("simulated_outcome")
  createdByUserId       String?                @map("created_by_user_id")
  completedAt           DateTime?              @map("completed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([invoiceId])
  @@map("platform_payment_checkouts")
}

enum SubscriptionExtensionRequestStatus {
  OPEN
  HANDLED
  DECLINED
}

/// Demande d'extension de l'abonnement envoyee par l'agence (lots,
/// coproprietes, chantiers, pack) ; notifiee par e-mail au super-admin.
model SubscriptionExtensionRequest {
  id                String                             @id @default(uuid()) @db.Uuid
  tenantId          String                             @map("tenant_id")
  requestedByUserId String?                            @map("requested_by_user_id")
  catalogCode       String?                            @map("catalog_code")
  quantity          Int?
  message           String                             @db.Text
  status            SubscriptionExtensionRequestStatus @default(OPEN)
  handledAt         DateTime?                          @map("handled_at")
  handledByUserId   String?                            @map("handled_by_user_id")
  handledNote       String?                            @map("handled_note") @db.Text
  createdAt         DateTime                           @default(now()) @map("created_at")
  updatedAt         DateTime                           @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("subscription_extension_requests")
}

enum TenantDataExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  EXPIRED
}

/// Lot S7 (besoin 8) : archive ZIP de toutes les donnees et de tous les
/// fichiers d'une agence, preparee en tache de fond a la demande du
/// super-admin. L'archive vit sous `<UPLOADS_DIR>/exports/<tenantId>/`, jamais
/// servie en statique ; `filePath` ne sort jamais dans une reponse d'API.
/// Aucune relation Prisma vers Tenant : l'historique des exports survit a la
/// suppression de l'agence, comme `AuditLog`.
model TenantDataExport {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id")
  status           TenantDataExportStatus @default(QUEUED)
  requestedById    String                 @map("requested_by_id")
  filePath         String?                @map("file_path")
  sizeBytes        BigInt?                @map("size_bytes")
  modelCount       Int?                   @map("model_count")
  rowCount         Int?                   @map("row_count")
  fileCount        Int?                   @map("file_count")
  missingFileCount Int?                   @map("missing_file_count")
  error            String?                @db.Text
  startedAt        DateTime?              @map("started_at")
  finishedAt       DateTime?              @map("finished_at")
  expiresAt        DateTime?              @map("expires_at")
  createdAt        DateTime               @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("tenant_data_exports")
}

// =============================================================================
// PATRIMOINE — Lot P4 : entités détentrices et fiscalité Côte d'Ivoire / Mali
// =============================================================================

enum HoldingEntityForm {
  SCI
  HOLDING
  COMPANY
  INDIVIDUAL
  OTHER
}

/// Pays gérés par le moteur fiscal (ISO 3166-1 alpha-2). Un nouveau pays = une migration.
enum FiscalCountry {
  CI
  ML
}

enum TaxKind {
  PROPERTY_TAX
  RENTAL_INCOME_TAX
}

/// Sélecteurs de paramètres. ANY = toutes valeurs ; refusé par zod dans les saisies.
enum TaxPropertyKind {
  ANY
  BUILT
  UNBUILT
}

enum TaxOccupancy {
  ANY
  MAIN_RESIDENCE
  OWNER_OCCUPIED
  RENTED
  VACANT
}

enum TaxOwnerKind {
  ANY
  INDIVIDUAL
  COMPANY
}

enum TaxParameterUnit {
  PERCENT
  AMOUNT
  YEARS
  BOOLEAN
  CODE
}

enum TaxParameterStatus {
  A_VALIDER
  VALIDE
}

model HoldingEntity {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id")
  name            String
  legalForm       HoldingEntityForm @map("legal_form")
  country         FiscalCountry
  rccm            String?
  /// NCC (Côte d'Ivoire) ou NIF (Mali).
  taxId           String?           @map("tax_id")
  contactId       String?           @map("contact_id")
  /// Organigramme seulement : aucune consolidation transitive en P4.
  parentEntityId  String?           @map("parent_entity_id") @db.Uuid
  /// Surcharge du statut fiscal (SCI de copropriété => INDIVIDUAL, etc.). Null = déduit de legalForm.
  fiscalOwnerKind TaxOwnerKind?     @map("fiscal_owner_kind")
  notes           String?           @db.Text
  isActive        Boolean           @default(true) @map("is_active")
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      CrmContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  parentEntity HoldingEntity?    @relation("HoldingEntityParent", fields: [parentEntityId], references: [id], onDelete: SetNull)
  children     HoldingEntity[]   @relation("HoldingEntityParent")
  holdings     PropertyHolding[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([parentEntityId])
  @@index([contactId])
  @@map("holding_entities")
}

model PropertyHolding {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id")
  propertyId      String    @map("property_id")
  entityId        String    @map("entity_id") @db.Uuid
  /// En pourcentage : 50 pour 50 %. Quatre décimales.
  sharePercent    Decimal   @map("share_percent") @db.Decimal(7, 4)
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  notes           String?
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entity   HoldingEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, entityId])
  @@index([tenantId])
  @@index([entityId])
  @@map("property_holdings")
}

model PropertyTaxProfile {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @map("tenant_id")
  propertyId          String           @unique @map("property_id")
  country             FiscalCountry?
  builtStatus         TaxPropertyKind? @map("built_status")
  occupancy           TaxOccupancy?
  declaredRentalValue Decimal?         @map("declared_rental_value") @db.Decimal(14, 2)
  exemptUntilYear     Int?             @map("exempt_until_year")
  exemptionReason     String?          @map("exemption_reason")
  notes               String?
  updatedByUserId     String?          @map("updated_by_user_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("property_tax_profiles")
}

/// Hypotheses de projection d'un bien detenu (Patrimoine, spec 029) : une ligne
/// par bien, posee par l'agence ; absente = valeurs par defaut du serveur.
model PropertyYieldAssumption {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id")
  propertyId        String   @unique @map("property_id")
  years             Int
  valueGrowthRate   Decimal  @map("value_growth_rate") @db.Decimal(7, 4)
  rentGrowthRate    Decimal  @map("rent_growth_rate") @db.Decimal(7, 4)
  expenseGrowthRate Decimal  @map("expense_growth_rate") @db.Decimal(7, 4)
  vacancyRate       Decimal  @map("vacancy_rate") @db.Decimal(7, 4)
  updatedByUserId   String?  @map("updated_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("property_yield_assumptions")
}

/// GLOBAL (plateforme, sans agence) : référentiel fiscal versionné par pays et par année,
/// alimenté par migration. Chaque ligne porte sa source et son statut de validation.
model TaxParameter {
  id           String             @id @default(uuid()) @db.Uuid
  country      FiscalCountry
  year         Int
  taxKind      TaxKind            @map("tax_kind")
  key          String             @map("param_key")
  propertyKind TaxPropertyKind    @default(ANY) @map("property_kind")
  occupancy    TaxOccupancy       @default(ANY)
  ownerKind    TaxOwnerKind       @default(ANY) @map("owner_kind")
  bracketIndex Int                @default(0) @map("bracket_index")
  lowerBound   Decimal?           @map("lower_bound") @db.Decimal(16, 2)
  upperBound   Decimal?           @map("upper_bound") @db.Decimal(16, 2)
  value        Decimal?           @db.Decimal(16, 6)
  valueText    String?            @map("value_text")
  unit         TaxParameterUnit
  label        String
  source       String
  sourceUrl    String?            @map("source_url")
  status       TaxParameterStatus @default(A_VALIDER)
  notes        String?            @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([country, year, taxKind, key, propertyKind, occupancy, ownerKind, bracketIndex], map: "tax_parameters_selector_key")
  @@index([country, year])
  @@map("tax_parameters")
}
