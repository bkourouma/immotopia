  approvedByResolutionId String?      @map("approved_by_resolution_id") @db.Uuid
  totalAmount            Decimal      @map("total_amount") @db.Decimal(14, 2)
  currency               String       @default("XOF")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  syndicate            Syndicate              @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  approvedByResolution GMResolution?          @relation(fields: [approvedByResolutionId], references: [id], onDelete: SetNull)
  lines                BudgetLineItem[]
  allocations          BudgetAllocation[]
  chargeCallBatches    ChargeCallBatch[]
  chargeSchedules      SyndicChargeSchedule[]

  @@index([syndicateId])
  @@index([approvedByResolutionId])
  @@index([syndicateId, fiscalYear])
  @@map("syndicate_budgets")
}

model BudgetLineItem {
  id              String          @id @default(uuid()) @db.Uuid
  budgetId        String          @map("budget_id") @db.Uuid
  category        String
  description     String
  amountForecast  Decimal         @map("amount_forecast") @db.Decimal(14, 2)
  amountActual    Decimal         @default(0) @map("amount_actual") @db.Decimal(14, 2)
  distributionKey DistributionKey @map("distribution_key")
  accountId       String?         @map("account_id") @db.Uuid
  /// Fonds alimente par ce poste : la part du poste dans chaque paiement de
  /// charges y est versee (lib/syndics/fund-credits.ts).
  fundId          String?         @map("fund_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  budget              SyndicateBudget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account             ChartOfAccount?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fund                SyndicateFund?           @relation(fields: [fundId], references: [id], onDelete: SetNull)
  incidentImputations IncidentCostImputation[]
  providerInvoices    SyndicProviderInvoice[]

  @@index([budgetId])
  @@index([accountId])
  @@index([fundId])
  @@map("budget_line_items")
}

model BudgetAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  budgetId       String   @map("budget_id") @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  totalAllocated Decimal  @map("total_allocated") @db.Decimal(14, 2)
  breakdown      Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  budget SyndicateBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  lot    SyndicateLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([lotId])
  @@map("budget_allocations")
}

/// Plan de comptes, desormais porte par le tenant.
///
/// `syndicateId` devient optionnel : un plan de portee OPERATIONS n'appartient
/// a aucune copropriete. L'unicite `(syndicateId, accountNumber)` a ete retiree
/// et remplacee par DEUX index uniques partiels crees en SQL brut, parce que
/// Postgres considere deux NULL comme distincts et que le DSL Prisma ne sait
/// pas exprimer un WHERE. Voir la migration `generalize_accounting_scope`.
model ChartOfAccount {
  id              String          @id @default(uuid()) @db.Uuid
  syndicateId     String?         @map("syndicate_id") @db.Uuid
  tenantId        String          @map("tenant_id")
  scope           AccountingScope @default(SYNDICATE)
  accountNumber   String          @map("account_number")
  accountName     String          @map("account_name")
  accountClass    Int             @map("account_class")
  accountType     AccountType     @map("account_type")
  isAuxiliary     Boolean         @default(false) @map("is_auxiliary")
  parentAccountId String?         @map("parent_account_id") @db.Uuid
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  syndicate       Syndicate?         @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          ChartOfAccount?    @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  children        ChartOfAccount[]   @relation("AccountHierarchy")
  journalLines    JournalEntryLine[]
  budgetLines     BudgetLineItem[]
  treasuryAccount TreasuryAccount?

  costCategories CostCategory[]

  @@index([syndicateId])
  @@index([parentAccountId])
  @@index([tenantId])
  @@index([tenantId, scope])
  @@map("chart_of_accounts")
}

/// Journal comptable, desormais porte par le tenant. Meme generalisation que
/// `ChartOfAccount`, sans le probleme d'unicite : ce modele n'a jamais porte
/// de contrainte `@@unique`.
model AccountingJournal {
  id          String          @id @default(uuid()) @db.Uuid
  syndicateId String?         @map("syndicate_id") @db.Uuid
  tenantId    String          @map("tenant_id")
  scope       AccountingScope @default(SYNDICATE)
  journalType JournalType     @map("journal_type")
  label       String
  code        String
  fiscalYear  Int             @map("fiscal_year")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  syndicate Syndicate?     @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   JournalEntry[]

  @@index([syndicateId])
  @@index([syndicateId, fiscalYear])
  @@index([tenantId])
  @@index([tenantId, scope, fiscalYear])
  @@map("accounting_journals")
}

/// Ecriture comptable.
///
/// `documentType` / `documentId` remplacent, pour les pieces du lot 2, l'usage
/// generique de `sourceType` / `sourceId` — sans toucher aux valeurs deja
/// ecrites par la copropriete. `voidedByEntryId` retrouve l'ecriture inverse
/// d'une annulation : on corrige par une piece d'annulation, jamais par
/// modification (principe P-6 du PRD).
model JournalEntry {
  id              String     @id @default(uuid()) @db.Uuid
  journalId       String     @map("journal_id") @db.Uuid
  tenantId        String     @map("tenant_id")
  documentType    String?    @map("document_type")
  documentId      String?    @map("document_id")
  voidedByEntryId String?    @map("voided_by_entry_id") @db.Uuid
  entryDate       DateTime   @map("entry_date")
  reference       String
  description     String
  sourceType      SourceType @map("source_type")
  sourceId        String?    @map("source_id")
  isLocked        Boolean    @default(false) @map("is_locked")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  journal AccountingJournal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines   JournalEntryLine[]

  voidedByEntry JournalEntry?  @relation("EntryVoid", fields: [voidedByEntryId], references: [id], onDelete: SetNull)
  voidsEntries  JournalEntry[] @relation("EntryVoid")

  // Les pieces du lot 2 qui ont engendre cette ecriture. Une seule est jamais
  // renseignee : c'est `documentType` qui dit laquelle.
  supplierInvoices  SupplierInvoice[]  @relation("SupplierInvoiceEntry")
  supplierPayments  SupplierPayment[]  @relation("SupplierPaymentEntry")
  cashVouchers      CashVoucher[]      @relation("CashVoucherEntry")
  voidDocuments     VoidDocument[]     @relation("VoidDocumentReversingEntry")
  landLeasePayments LandLeasePayment[] @relation("LandLeasePaymentEntry")
  landLeaseAccruals LandLeaseAccrual[] @relation("LandLeaseAccrualEntry")

  salaryNotes        SalaryNote[]         @relation("SalaryNoteEntry")
  salaryPayments     SalaryPayment[]      @relation("SalaryPaymentEntry")
  progressStatements ProgressStatement[]  @relation("ProgressStatementEntry")
  contractorPayments ContractorPayment[]  @relation("ContractorPaymentEntry")
  retentionsHeld     RetentionGuarantee[] @relation("RetentionHeldEntry")
  retentionsReleased RetentionGuarantee[] @relation("RetentionReleasedEntry")

  stockMovements StockMovement[] @relation("StockMovementEntry")

  @@index([journalId])
  @@index([entryDate])
  @@index([tenantId])
  @@index([documentType, documentId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                  String              @id @default(uuid()) @db.Uuid
  entryId             String              @map("entry_id") @db.Uuid
  accountId           String              @map("account_id") @db.Uuid
  lotId               String?             @map("lot_id") @db.Uuid
  // Elargies de (12,2) a (14,2) au lot 2, pour s'aligner sur les tables
  // financieres. Un elargissement de precision ne perd aucune valeur : 12,2
  // est un sous-ensemble strict de 14,2.
  debit               Decimal             @default(0) @db.Decimal(14, 2)
  credit              Decimal             @default(0) @db.Decimal(14, 2)
  label               String
  isLettered          Boolean             @default(false) @map("is_lettered")
  letterRef           String?             @map("letter_ref")
  /// Lot 10 : compte auxiliaire (le proprietaire mandant pour le 4731).
  thirdPartyAccountId String?             @map("third_party_account_id") @db.Uuid
  /// Lot 10 : nature des fonds de mandant portes par la ligne.
  fundsNature         MandantFundsNature? @map("funds_nature")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  entry      JournalEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    ChartOfAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lot        SyndicateLot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  thirdParty ThirdPartyAccount? @relation(fields: [thirdPartyAccountId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([accountId])
  @@index([lotId])
  @@index([thirdPartyAccountId])
  @@map("journal_entry_lines")
}

model OwnerAccount {
  id            String   @id @default(uuid()) @db.Uuid
  syndicateId   String   @map("syndicate_id") @db.Uuid
  lotId         String   @unique @map("lot_id") @db.Uuid
  contactId     String   @map("contact_id")
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  currency      String   @default("XOF")
  lastUpdatedAt DateTime @updatedAt @map("last_updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  syndicate    Syndicate                 @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  lot          SyndicateLot              @relation(fields: [lotId], references: [id], onDelete: Cascade)
  contact      CrmContact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transactions OwnerAccountTransaction[]

  @@index([syndicateId])
  @@index([contactId])
  @@map("owner_accounts")
}

model OwnerAccountTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  transactionDate DateTime        @map("transaction_date")
  type            TransactionType
  debit           Decimal?        @db.Decimal(12, 2)
  credit          Decimal?        @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(14, 2)
  label           String
  reference       String?
  sourceId        String?         @map("source_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  account OwnerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([transactionDate])
  @@map("owner_account_transactions")
}

model SyndicateIncident {
  id                     String          @id @default(uuid()) @db.Uuid
  syndicateId            String          @map("syndicate_id") @db.Uuid
  reportedByContactId    String          @map("reported_by_contact_id")
  lotId                  String?         @map("lot_id") @db.Uuid
  assetId                String?         @map("asset_id") @db.Uuid
  incidentType           IncidentType    @map("incident_type")
  description            String
  urgency                IncidentUrgency
  status                 IncidentStatus  @default(REPORTED)
  reportedAt             DateTime        @map("reported_at")
  resolvedAt             DateTime?       @map("resolved_at")
  maintenanceWorkOrderId String?         @map("maintenance_work_order_id")
  providerId             String?         @map("provider_id") @db.Uuid
  photos                 Json?
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  syndicate         Syndicate                @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  reportedByContact CrmContact               @relation(fields: [reportedByContactId], references: [id], onDelete: Cascade)
  lot               SyndicateLot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  asset             CommonAreaAsset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  provider          ServiceProvider?         @relation(fields: [providerId], references: [id], onDelete: SetNull)
  imputations       IncidentCostImputation[]
  providerInvoices  SyndicProviderInvoice[]

  @@index([syndicateId])
  @@index([lotId])
  @@index([assetId])
  @@index([providerId])
  @@index([status])
  @@map("syndicate_incidents")
}

model IncidentCostImputation {
  id             String         @id @default(uuid()) @db.Uuid
  incidentId     String         @map("incident_id") @db.Uuid
  imputationType ImputationType @map("imputation_type")
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("XOF")
  budgetLineId   String?        @map("budget_line_id") @db.Uuid
  lotId          String?        @map("lot_id") @db.Uuid
  contractId     String?        @map("contract_id") @db.Uuid
  journalEntryId String?        @map("journal_entry_id") @db.Uuid
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  incident   SyndicateIncident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  lot        SyndicateLot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)
  contract   MaintenanceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  budgetLine BudgetLineItem?      @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([lotId])
  @@index([contractId])
  @@index([budgetLineId])
  @@map("incident_cost_imputations")
}

// =============================================================
// SYNDIC S6 - FACTURES ET PAIEMENTS DES PRESTATAIRES
// =============================================================
// Chaine d'une depense de copropriete : la facture du prestataire est
// enregistree (charge 6xx / prestataire 401 dans la comptabilite de la
// COPROPRIETE, jamais celle de l'agence), puis reglee en un ou plusieurs
// paiements (401 / 521) qui debitent un fonds et laissent un mouvement.
// Code : lib/syndics/provider-invoices.ts.

enum SyndicProviderInvoiceStatus {
  RECORDED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SyndicFundMovementDirection {
  CREDIT
  DEBIT
}

enum SyndicFundMovementSource {
  MANUAL_ADJUSTMENT
  PROVIDER_PAYMENT
  PROVIDER_PAYMENT_REVERSAL
  /// Solde d'ouverture (solde repris a la creation du fonds ou a la reprise).
  OPENING
  /// Part d'un paiement de charges affectee a un appel (`sourceId` = paiement).
  CHARGE_PAYMENT
  /// Depense payee par le fonds, saisie a la main.
  MANUAL_EXPENSE
}

/// Facture d'un prestataire, rattachee a une copropriete.
///
/// L'unicite (copropriete, prestataire, numero) hors factures annulees est un
/// index unique PARTIEL cree en SQL brut dans la migration
/// `20260929150000_syndic_factures_prestataires` : le DSL Prisma ne sait pas
/// exprimer le WHERE (meme cas que `chart_of_accounts`).
model SyndicProviderInvoice {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id")
  syndicateId      String                      @map("syndicate_id") @db.Uuid
  providerId       String                      @map("provider_id") @db.Uuid
  contractId       String?                     @map("contract_id") @db.Uuid
  incidentId       String?                     @map("incident_id") @db.Uuid
  budgetLineItemId String?                     @map("budget_line_item_id") @db.Uuid
  fundId           String?                     @map("fund_id") @db.Uuid
  number           String
  label            String
  invoiceDate      DateTime                    @map("invoice_date")
  dueDate          DateTime?                   @map("due_date")
  amountHT         Decimal                     @map("amount_ht") @db.Decimal(14, 2)
  vatAmount        Decimal                     @default(0) @map("vat_amount") @db.Decimal(14, 2)
  amountTTC        Decimal                     @map("amount_ttc") @db.Decimal(14, 2)
  amountPaid       Decimal                     @default(0) @map("amount_paid") @db.Decimal(14, 2)
  currency         String                      @default("XOF")
  expenseAccountId String?                     @map("expense_account_id") @db.Uuid
  /// Identifiant de stockage prive (`/uploads/syndics/<id>/factures-prestataires/<f>`),
  /// jamais renvoye au client : la piece se lit par la route `.../fichier`.
  filePath         String?                     @map("file_path")
  fileName         String?                     @map("file_name")
  status           SyndicProviderInvoiceStatus @default(RECORDED)
  cancelledAt      DateTime?                   @map("cancelled_at")
  cancelReason     String?                     @map("cancel_reason")
  journalEntryId   String?                     @map("journal_entry_id") @db.Uuid
  cancelEntryId    String?                     @map("cancel_entry_id") @db.Uuid
  createdById      String?                     @map("created_by_id")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  syndicate  Syndicate               @relation(fields: [syndicateId], references: [id], onDelete: Cascade)
  provider   ServiceProvider         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  contract   MaintenanceContract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  incident   SyndicateIncident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  budgetLine BudgetLineItem?         @relation(fields: [budgetLineItemId], references: [id], onDelete: SetNull)
  fund       SyndicateFund?          @relation(fields: [fundId], references: [id], onDelete: SetNull)
  payments   SyndicProviderPayment[]

  @@index([tenantId])
  @@index([syndicateId, status])
  @@index([syndicateId, providerId])
  @@index([contractId])
  @@index([incidentId])
  @@index([budgetLineItemId])
  @@index([fundId])
  @@map("syndic_provider_invoices")
}

/// Paiement (partiel ou total) d'une facture de prestataire. Un paiement
/// annule n'est pas supprime : `cancelledAt` le marque, et son mouvement de
/// fonds et son ecriture sont contre-passes.
model SyndicProviderPayment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id")
  invoiceId      String        @map("invoice_id") @db.Uuid
  fundId         String?       @map("fund_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  paidAt         DateTime      @map("paid_at")
  method         PaymentMethod
  reference      String?
  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  cancelledAt    DateTime?     @map("cancelled_at")
  cancelReason   String?       @map("cancel_reason")
  cancelEntryId  String?       @map("cancel_entry_id") @db.Uuid
  createdById    String?       @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  invoice SyndicProviderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fund    SyndicateFund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([fundId])
  @@map("syndic_provider_payments")
}

/// Journal des mouvements d'un fonds de copropriete. `balanceAfter` est le
/// solde du fonds juste apres le mouvement (le fonds est verrouille pendant
/// l'ecriture, voir provider-invoices.ts).
model SyndicateFundMovement {
  id           String                      @id @default(uuid()) @db.Uuid
  tenantId     String                      @map("tenant_id")
  fundId       String                      @map("fund_id") @db.Uuid
  direction    SyndicFundMovementDirection
  amount       Decimal                     @db.Decimal(14, 2)
  balanceAfter Decimal                     @map("balance_after") @db.Decimal(14, 2)
  label        String
  sourceType   SyndicFundMovementSource    @map("source_type")
  sourceId     String?                     @map("source_id")
  createdById  String?                     @map("created_by_id")
  createdAt    DateTime                    @default(now()) @map("created_at")

  fund SyndicateFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fundId, createdAt])
  @@index([sourceType, sourceId])
  @@map("syndicate_fund_movements")
}

enum ValuationMethod {
  MANUAL
  MARKET_ESTIMATE
  EXPERT_APPRAISAL
}

enum LoanStatus {
  ACTIVE
  CLOSED
  DEFAULTED
}

/// Periodicite d'une depense du bien (plan de tresorerie previsionnel, spec 030).
/// ONE_OFF : depense ponctuelle, deja passee. Les autres valeurs ancrent une
/// recurrence sur `paidAt`.
enum ExpenseRecurrence {
  ONE_OFF
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ExpenseCategory {
  PROPERTY_TAX
  CONDO_FEES
  INSURANCE
  ROUTINE_MAINTENANCE
  RENOVATION
  MANAGEMENT_FEES
  UTILITIES
  OTHER
}

enum StatementStatus {
  DRAFT
  SENT
  PAID
}

enum StatementItemType {
  RENT_COLLECTED
  EXPENSE_DEDUCTED
  MANAGEMENT_FEE
  /// TVA facturee sur les honoraires, quand l'agence y est assujettie.
  MANAGEMENT_FEE_VAT
  ADVANCE
  OTHER
}

/// Assiette des honoraires de gestion.
///
/// RENT_ONLY : la seule part « loyer » de chaque encaissement, au prorata de
/// l'echeance qu'il solde — les charges et les penalites n'en portent pas.
/// ALL_COLLECTED : tout ce qui est encaisse.
enum ManagementFeeBase {
  RENT_ONLY
  ALL_COLLECTED
}

/// PERCENT : un taux sur l'assiette. FIXED : un forfait par echeance, au
/// prorata de ce qui en est encaisse.
enum ManagementFeeMode {
  PERCENT
  FIXED
}

/// D'ou vient le taux applique a un encaissement : le bail l'emporte sur le
/// proprietaire, qui l'emporte sur l'agence.
enum ManagementFeeSource {
  LEASE
  OWNER
  AGENCY
}

/// Conditions d'honoraires negociees avec un proprietaire. Remplacent celles
/// de l'agence pour tous ses baux, sauf ceux qui ont les leurs.
model OwnerManagementTerms {
  id                       String            @id @default(uuid()) @db.Uuid
  tenantId                 String            @map("tenant_id")
  ownerClientId            String            @unique @map("owner_client_id")
  managementFeeMode        ManagementFeeMode @default(PERCENT) @map("management_fee_mode")
  managementFeeRate        Decimal?          @map("management_fee_rate") @db.Decimal(5, 2)
  managementFeeFixedAmount Decimal?          @map("management_fee_fixed_amount") @db.Decimal(14, 2)
  managementFeeBase        ManagementFeeBase @default(RENT_ONLY) @map("management_fee_base")
  updatedByUserId          String?           @map("updated_by_user_id")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerClient TenantClient @relation(fields: [ownerClientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("owner_management_terms")
}

/// Conditions propres a un bail, et son gestionnaire.
///
/// `managementFeeMode` nul : le bail n'a pas de conditions propres et suit
/// son proprietaire, puis l'agence. Le gestionnaire, lui, peut exister sans
/// conditions propres.
model LeaseManagementTerms {
  id                       String             @id @default(uuid()) @db.Uuid
  tenantId                 String             @map("tenant_id")
  leaseId                  String             @unique @map("lease_id") @db.Uuid
  managementFeeMode        ManagementFeeMode? @map("management_fee_mode")
  managementFeeRate        Decimal?           @map("management_fee_rate") @db.Decimal(5, 2)
  managementFeeFixedAmount Decimal?           @map("management_fee_fixed_amount") @db.Decimal(14, 2)
  managementFeeBase        ManagementFeeBase? @map("management_fee_base")
  agentUserId              String?            @map("agent_user_id")
  updatedByUserId          String?            @map("updated_by_user_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease  RentalLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  agent  User?       @relation("LeaseManagementAgent", fields: [agentUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([agentUserId])
  @@map("lease_management_terms")
}

/// Part des honoraires HT reversee a un collaborateur sur les baux dont il
/// est le gestionnaire.
model AgentCommissionRate {
