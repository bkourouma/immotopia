# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User-uploaded content (never commit tenant data)
uploads/
packages/uploads/
packages/api/uploads/

# Generated documents (leases, statements) produced at runtime
assets/generated_documents/
# Per-tenant document templates uploaded at runtime (base templates stay tracked)
assets/modeles_documents/tenants/
# Global default templates stored at runtime by db:seed:document-templates
# (the source .docx at the root of modeles_documents/ stay tracked)
assets/modeles_documents/default/
# Word lock files
~$*

# Local reports / one-off dumps
packages/api/missing-lease-data-report.json

