{
  "name": "@immotopia/web",
  "version": "1.0.0",
  "description": "ImmoTopia web application",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "i18n:extract": "node scripts/i18n-migrate.mjs",
    "i18n:check": "node scripts/i18n-migrate.mjs --check",
    "help:check": "node scripts/help-coverage.mjs",
    "measure:entry": "node scripts/measure-entry.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "5.107.1",
    "ajv": "^8.17.1",
    "antd": "^6.7.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.26",
    "i18next": "^23.16.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "livekit-client": "^2.23.0",
    "lucide-react": "^0.556.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.21.1",
    "react-simple-code-editor": "^0.14.1",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@immotopia/eslint-config": "*",
    "@immotopia/tsconfig": "*",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.10.6",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.2.45",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
